@model StaffManagement.Model.Entities.LeaveTypeMaster
@{ ViewData["Title"] = "Add leave type"; }
<h1 class="mb-1">Add leave type</h1><p class="text-muted mb-4">Add an option employees can select when applying for leave.</p>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
    <form asp-action="Create" method="post"><partial name="_Form" model="Model" />
        <div class="d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button type="submit" class="btn btn-primary">Create</button></div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
