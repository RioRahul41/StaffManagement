@using StaffManagement.Model.Entities
@model IReadOnlyList<LeaveTypeMaster>
@{ ViewData["Title"] = "Leave types"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><p class="text-primary fw-semibold mb-1">LEAVE MANAGEMENT</p><h1 class="mb-1">Leave types</h1><p class="text-muted mb-0">Manage the options employees can choose when applying for leave.</p></div>
    <a asp-action="Create" class="btn btn-primary">Add leave type</a>
</div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th class="text-center">S.No.</th><th>Leave type</th><th>Status</th><th>Created date</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-muted py-4">No leave types found.</td></tr>
        }
        else
        {
            @foreach (var leaveType in Model.Select((item, index) => new { Item = item, Index = index + 1 }))
            {
                <tr>
                    <td class="text-center">@leaveType.Index</td><td class="fw-semibold">@leaveType.Item.Name</td>
                    <td><span class="badge @(leaveType.Item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(leaveType.Item.IsActive ? "Active" : "Inactive")</span></td>
                    <td>@leaveType.Item.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td class="text-end text-nowrap">
                        @if (leaveType.Item.IsActive)
                        {
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Leave type actions">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false" style="display:block"><circle cx="8" cy="3" r="1.3"/><circle cx="8" cy="8" r="1.3"/><circle cx="8" cy="13" r="1.3"/></svg>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a asp-action="Edit" asp-route-id="@leaveType.Item.Id" class="dropdown-item">Edit</a></li>
                                    <li><form asp-action="Delete" asp-route-id="@leaveType.Item.Id" method="post" class="leave-type-delete-form"><button type="submit" class="dropdown-item text-danger">Delete</button></form></li>
                                </ul>
                            </div>
                        }
                        else { <span class="text-muted">Inactive</span> }
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div></div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.querySelectorAll('.leave-type-delete-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                Swal.fire({ title: 'Deactivate this leave type?', text: 'It will no longer appear in the Apply Leave list. Existing requests stay unchanged.', icon: 'warning', showCancelButton: true, confirmButtonColor: '#dc3545', cancelButtonColor: '#6c757d', confirmButtonText: 'Deactivate', cancelButtonText: 'Cancel' })
                    .then(function (result) { if (result.isConfirmed) form.submit(); });
            });
        });
    </script>
}
