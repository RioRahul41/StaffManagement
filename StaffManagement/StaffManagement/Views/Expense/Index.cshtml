@using StaffManagement.Core.DTOs
@model PagedResultDto<StaffManagement.Core.DTOs.ExpenseModel.EmployeeExpenseGroupDto>
@{
    ViewData["Title"] = "Employee Expenses";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">EXPENSE MANAGEMENT</p>
        <h1 class="mb-1">Employee Expenses</h1>
        <p class="text-muted mb-0">Submit and review employee expense details.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add expense</a>
</div>
@if (Model.Items.Count == 0)
{
    <div class="card border-0 shadow-sm"><div class="card-body text-center py-5"><h4>No expense records found</h4><p class="text-muted">Add an expense record to begin.</p><a asp-action="Create" class="btn btn-primary">Add expense</a></div></div>
}
else
{
    <div class="card border-0 shadow-sm"><div class="table-responsive"><table id="expenseTable" class="table table-hover align-middle mb-0 expense-table">
        <colgroup><col style="width: 8%" /><col style="width: 13%" /><col style="width: 14%" /><col style="width: 10%" /><col style="width: 10%" /><col style="width: 12%" /><col style="width: 13%" /><col style="width: 8%" /><col style="width: 12%" /></colgroup>
        <thead class="table-light"><tr><th>Employee ID</th><th>Title</th><th>Categories</th><th class="text-center">From date</th><th class="text-center">To date</th><th class="text-end">Total bill amount</th><th>Approval notes</th><th class="text-center">Status</th><th class="text-center">Actions</th></tr></thead>
        <tbody>
        @foreach (var expense in Model.Items)
        {
            <tr>
                <td class="text-nowrap">@expense.EmployeeId</td>
                <td class="expense-wrap-cell">@expense.Title</td>
                <td class="expense-wrap-cell">@string.Join(", ", expense.Categories)</td>
                <td class="text-center text-nowrap">@expense.FromDate.ToString("yyyy-MM-dd")</td>
                <td class="text-center text-nowrap">@expense.ToDate.ToString("yyyy-MM-dd")</td>
                <td class="text-end text-nowrap" data-order="@expense.BillAmount">@expense.BillAmount.ToString("N2")</td>
                <td class="expense-wrap-cell">@(string.IsNullOrWhiteSpace(expense.ApprovalNotes) ? "-" : expense.ApprovalNotes)</td>
                <td class="text-center text-nowrap"><span class="badge @(expense.Status == "Approved" ? "text-bg-success" : expense.Status == "Rejected" ? "text-bg-danger" : expense.Status == "Mixed" ? "text-bg-info" : "text-bg-warning")">@expense.Status</span></td>
                <td class="text-center text-nowrap">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Actions</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @foreach (var bill in expense.Expenses)
                            {
                                @if (expense.Expenses.Count > 1)
                                {
                                    <li><h6 class="dropdown-header">@bill.Category - @bill.BillNumber</h6></li>
                                }
                                <li><a class="dropdown-item" asp-action="Details" asp-route-id="@bill.Id">Details</a></li>
                                <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@bill.Id">Edit</a></li>
                                <li><a class="dropdown-item" asp-action="Delete" asp-route-id="@bill.Id">Delete</a></li>
                                @if (expense.Expenses.Count > 1 && bill != expense.Expenses[^1])
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                }
                            }
                        </ul>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table></div></div>
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Expense pages"><ul class="pagination">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">Previous</a></li>
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@pageNumber">@pageNumber</a></li>
            }
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">Next</a></li>
        </ul></nav>
    }
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.css" />
    <style>
        .expense-table { min-width: 1250px; table-layout: fixed; }
        .expense-table th, .expense-table td { vertical-align: middle; }
        .expense-wrap-cell { overflow-wrap: anywhere; white-space: normal; }
    </style>
}

@section Scripts {
    <script src="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.js"></script>
    <script>
        if (document.querySelector('#expenseTable')) {
            new DataTable('#expenseTable', {
                paging: false,
                info: false,
                lengthChange: false,
                autoWidth: false,
                columnDefs: [
                    { targets: [0, 3, 4, 7, 8], className: 'text-center text-nowrap' },
                    { targets: 5, className: 'text-end text-nowrap' },
                    { targets: -1, orderable: false, searchable: false }
                ]
            });
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["Success"] is string success)
    {
        <script>Swal.fire({ icon: 'success', title: 'Success', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(success)), timer: 2200, showConfirmButton: false });</script>
    }
    @if (TempData["Error"] is string error)
    {
        <script>Swal.fire({ icon: 'error', title: 'Unable to complete action', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(error)) });</script>
    }
}
