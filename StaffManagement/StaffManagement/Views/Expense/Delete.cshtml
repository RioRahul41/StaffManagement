@model StaffManagement.Core.DTOs.ExpenseModel.EmployeeExpenseDto
@{
    ViewData["Title"] = "Delete Expense";
}
<h1>Delete expense</h1>
<div class="alert alert-warning">This action permanently deletes the expense record.</div>
<p>Delete the expense <strong>@Model.Title</strong> for <strong>@Model.FirstName</strong>?</p>
<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button class="btn btn-danger" type="submit">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
