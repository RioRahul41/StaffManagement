@model StaffManagement.Core.DTOs.ExpenseModel.EmployeeExpenseGroupDto
@{
    ViewData["Title"] = "Expense group details";
}
<h1>Expense details</h1>
<div class="card border-0 shadow-sm mb-4"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Employee ID</dt><dd class="col-sm-9">@Model.EmployeeId</dd>
        <dt class="col-sm-3">Title</dt><dd class="col-sm-9">@Model.Title</dd>
        <dt class="col-sm-3">From date</dt><dd class="col-sm-9">@Model.FromDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">To date</dt><dd class="col-sm-9">@Model.ToDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Total bill amount</dt><dd class="col-sm-9 fw-semibold">@Model.BillAmount.ToString("N2")</dd>
        <dt class="col-sm-3">Expense status</dt><dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th class="text-center">S.No.</th><th>Category</th><th>Bill number</th><th>Amount</th><th>Description</th><th>Document</th><th>Expense status</th></tr></thead>
    <tbody>
    @foreach (var bill in Model.Expenses.Select((item, index) => new { Item = item, Index = index + 1 }))
    {
        <tr>
            <td class="text-center">@bill.Index</td>
            <td>@bill.Item.Category</td>
            <td>@bill.Item.BillNumber</td>
            <td class="text-end">@bill.Item.BillAmount.ToString("N2")</td>
            <td>@(string.IsNullOrWhiteSpace(bill.Item.Description) ? "-" : bill.Item.Description)</td>
            <td>@if (!string.IsNullOrWhiteSpace(bill.Item.DocumentPath)) { <a asp-action="Document" asp-route-id="@bill.Item.Id">Download</a> } else { <span class="text-muted">-</span> }</td>
            <td>@bill.Item.Status</td>
        </tr>
    }
    </tbody>
</table></div></div>
<div class="mt-3"><a asp-action="Index" class="btn btn-secondary">Back</a></div>
