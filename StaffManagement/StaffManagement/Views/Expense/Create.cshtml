@model StaffManagement.Models.CreateExpenseBatchViewModel
@{
    ViewData["Title"] = "Add Expense";
    var canApprove = User.IsInRole("Admin") || User.IsInRole("HR");
    var employees = ViewBag.Employees as IReadOnlyList<StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto> ?? [];
}
<h1>Add employee expenses</h1>
<p class="text-muted">Add one entry for each bill. The total below adds the amounts from all entries.</p>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-3" id="expense-form">
    <div id="expense-entries" class="col-12">
        @for (var i = 0; i < Model.Expenses.Count; i++)
        {
            <section class="card border-0 shadow-sm mb-3 expense-entry" data-entry-index="@i">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong class="expense-entry-title">Expense @(i + 1)</strong>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-remove-expense>Remove</button>
                </div>
                <div class="card-body row g-3">
                    @if (canApprove)
                    {
                        <div class="col-md-6">
                            <label asp-for="Expenses[i].EmployeeId" class="form-label">Employee ID <span class="text-danger">*</span></label>
                            <select asp-for="Expenses[i].EmployeeId" class="form-select" required><option value="">-- Select employee --</option>@foreach (var employee in employees) { <option value="@employee.Id">@employee.Id - @employee.FirstName @employee.LastName (@employee.Email)</option> }</select>
                            <span asp-validation-for="Expenses[i].EmployeeId" class="text-danger"></span>
                        </div>
                    }
                    else
                    {
                        @* Employee ID is assigned from the signed-in employee profile. *@
                        <input asp-for="Expenses[i].EmployeeId" type="hidden" />
                    }
                    @if (i == 0)
                    {
                        <div class="col-md-6"><label asp-for="Expenses[i].Title" class="form-label">Title <span class="text-danger">*</span></label><input asp-for="Expenses[i].Title" class="form-control shared-expense-field" required /><span asp-validation-for="Expenses[i].Title" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="Expenses[i].FromDate" class="form-label">From date <span class="text-danger">*</span></label><input asp-for="Expenses[i].FromDate" class="form-control shared-expense-field" type="date" required /><span asp-validation-for="Expenses[i].FromDate" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="Expenses[i].ToDate" class="form-label">To date <span class="text-danger">*</span></label><input asp-for="Expenses[i].ToDate" class="form-control shared-expense-field" type="date" required /><span asp-validation-for="Expenses[i].ToDate" class="text-danger"></span></div>
                    }
                    else
                    {
                        <input asp-for="Expenses[i].Title" type="hidden" data-shared-field="Title" />
                        <input asp-for="Expenses[i].FromDate" type="hidden" data-shared-field="FromDate" />
                        <input asp-for="Expenses[i].ToDate" type="hidden" data-shared-field="ToDate" />
                    }
                    <div class="col-12 expense-add-button-slot d-flex justify-content-end">
                        @if (i == 0)
                        {
                            <button type="button" id="add-expense" class="btn btn-primary">Add Another Expense</button>
                        }
                    </div>
                    <div class="col-md-4"><label asp-for="Expenses[i].Category" class="form-label">Category <span class="text-danger">*</span></label><input asp-for="Expenses[i].Category" class="form-control" required /><span asp-validation-for="Expenses[i].Category" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="Expenses[i].Amount" class="form-label">Amount <span class="text-danger">*</span></label><input asp-for="Expenses[i].Amount" class="form-control expense-amount" type="number" min="0.01" step="0.01" required /><span asp-validation-for="Expenses[i].Amount" class="text-danger"></span></div>
                    <div class="col-md-4"><label asp-for="Expenses[i].BillNumber" class="form-label">Bill number <span class="text-danger">*</span></label><input asp-for="Expenses[i].BillNumber" class="form-control" required /><span asp-validation-for="Expenses[i].BillNumber" class="text-danger"></span></div>
                    <div class="col-md-6">
                        <label for="Documents_@i" class="form-label">Document <span class="text-danger">*</span></label>
                        <input type="file" id="Documents_@i" name="Documents[@i]" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" required />
                        @Html.ValidationMessage($"Documents[{i}]", "", new { @class = "text-danger" })
                        <div class="form-text">PDF, Word, Excel, PNG, or JPEG; maximum size 10 MB.</div>
                    </div>
                    <div class="col-12"><label asp-for="Expenses[i].Description" class="form-label"></label><textarea asp-for="Expenses[i].Description" class="form-control" rows="2"></textarea><span asp-validation-for="Expenses[i].Description" class="text-danger"></span></div>
                </div>
            </section>
        }
    </div>
    <div class="col-12 d-flex justify-content-end align-items-center gap-2">
        <span class="fw-semibold">Total amount for all entries:</span>
        <strong id="grand-total" aria-live="polite">0.00</strong>
    </div>
    <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Save expenses</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

<template id="expense-entry-template">
    <section class="card border-0 shadow-sm mb-3 expense-entry" data-entry-index="__index__">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong class="expense-entry-title">Expense</strong>
            <button type="button" class="btn btn-sm btn-outline-danger" data-remove-expense>Remove</button>
        </div>
        <div class="card-body row g-3">
            @if (canApprove)
            {
                <div class="col-md-6">
                    <label for="Expenses___index____EmployeeId" class="form-label">Employee ID <span class="text-danger">*</span></label>
                    <select name="Expenses[__index__].EmployeeId" id="Expenses___index____EmployeeId" class="form-select" required>
                        <option value="">-- Select employee --</option>
                        @foreach (var employee in employees)
                        {
                            <option value="@employee.Id">@employee.Id - @employee.FirstName @employee.LastName (@employee.Email)</option>
                        }
                    </select>
                    <span class="text-danger" data-valmsg-for="Expenses[__index__].EmployeeId" data-valmsg-replace="true"></span>
                </div>
            }
            else
            {
                @* Employee ID is assigned from the signed-in employee profile. *@
                <input type="hidden" name="Expenses[__index__].EmployeeId" value="@(Model.Expenses[0].EmployeeId)" />
            }
            <input type="hidden" name="Expenses[__index__].Title" data-shared-field="Title" />
            <input type="hidden" name="Expenses[__index__].FromDate" data-shared-field="FromDate" />
            <input type="hidden" name="Expenses[__index__].ToDate" data-shared-field="ToDate" />
            <div class="col-12 expense-add-button-slot d-flex justify-content-end"></div>
            <div class="col-md-4"><label for="Expenses___index____Category" class="form-label">Category <span class="text-danger">*</span></label><input type="text" name="Expenses[__index__].Category" id="Expenses___index____Category" class="form-control" required maxlength="100" /><span class="text-danger" data-valmsg-for="Expenses[__index__].Category" data-valmsg-replace="true"></span></div>
            <div class="col-md-4"><label for="Expenses___index____Amount" class="form-label">Amount <span class="text-danger">*</span></label><input type="number" name="Expenses[__index__].Amount" id="Expenses___index____Amount" class="form-control expense-amount" min="0.01" step="0.01" required /><span class="text-danger" data-valmsg-for="Expenses[__index__].Amount" data-valmsg-replace="true"></span></div>
            <div class="col-md-4"><label for="Expenses___index____BillNumber" class="form-label">Bill number <span class="text-danger">*</span></label><input type="text" name="Expenses[__index__].BillNumber" id="Expenses___index____BillNumber" class="form-control" required maxlength="100" /><span class="text-danger" data-valmsg-for="Expenses[__index__].BillNumber" data-valmsg-replace="true"></span></div>
            <div class="col-md-6">
                <label for="Documents___index__" class="form-label">Document <span class="text-danger">*</span></label>
                <input type="file" id="Documents___index__" name="Documents[__index__]" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" required />
                <span class="text-danger" data-valmsg-for="Documents[__index__]" data-valmsg-replace="true"></span>
                <div class="form-text">PDF, Word, Excel, PNG, or JPEG; maximum size 10 MB.</div>
            </div>
            <div class="col-12"><label for="Expenses___index____Description" class="form-label">Description</label><textarea name="Expenses[__index__].Description" id="Expenses___index____Description" class="form-control" rows="2" maxlength="2000"></textarea><span class="text-danger" data-valmsg-for="Expenses[__index__].Description" data-valmsg-replace="true"></span></div>
        </div>
    </section>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
            const entries = document.getElementById('expense-entries');
            const template = document.getElementById('expense-entry-template');
            const addExpenseButton = document.getElementById('add-expense');
            const reindexEntries = function () {
                const cards = entries.querySelectorAll('.expense-entry');
                cards.forEach(function (card, index) {
                    card.dataset.entryIndex = index;
                    card.querySelector('.expense-entry-title').textContent = 'Expense ' + (index + 1);
                    card.querySelectorAll('[name], [id], [for], [data-valmsg-for]').forEach(function (element) {
                        ['name', 'id', 'for', 'data-valmsg-for'].forEach(function (attribute) {
                            const value = element.getAttribute(attribute);
                            if (!value) return;
                            element.setAttribute(attribute, value
                                .replace(/\[\d+\]/g, '[' + index + ']')
                                .replace(/_\d+__/g, '_' + index + '__'));
                        });
                    });
                    const removeButton = card.querySelector('[data-remove-expense]');
                    removeButton.hidden = cards.length === 1;
                });
                const firstButtonSlot = entries.querySelector('.expense-entry:first-child .expense-add-button-slot');
                if (firstButtonSlot && addExpenseButton) firstButtonSlot.appendChild(addExpenseButton);
            };
            const updateGrandTotal = function () {
                const total = Array.from(entries.querySelectorAll('.expense-amount')).reduce(function (sum, amount) {
                    return sum + (Number.parseFloat(amount.value) || 0);
                }, 0);
                document.getElementById('grand-total').textContent = total.toFixed(2);
            };
            const syncTotal = function (amount) {
                updateGrandTotal();
            };

            document.getElementById('add-expense').addEventListener('click', function () {
                const currentEntry = entries.querySelector('.expense-entry:last-child');
                const requiredFields = Array.from(currentEntry.querySelectorAll('[required]'));
                const invalidField = requiredFields.find(function (field) {
                    return !field.value || !field.checkValidity();
                });
                if (invalidField) {
                    const fieldContainer = invalidField.closest('.col-md-6, .col-md-4, .col-md-3, .col-12');
                    const fieldLabel = fieldContainer?.querySelector('label')?.textContent.replace(/\*/g, '').trim();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Complete this expense first',
                        text: fieldLabel
                            ? `Please complete the ${fieldLabel} field before adding another expense.`
                            : 'Please complete all required fields before adding another expense.'
                    }).then(function () {
                        invalidField.focus();
                    });
                    return;
                }

                const index = entries.querySelectorAll('.expense-entry').length;
                entries.insertAdjacentHTML('beforeend', template.innerHTML.replaceAll('__index__', index));
                const newEntry = entries.querySelector('.expense-entry:last-child');
                newEntry.querySelectorAll('[data-shared-field]').forEach(function (field) {
                    const source = entries.querySelector('.expense-entry:first-child [name$=".' + field.dataset.sharedField + '"]');
                    field.value = source ? source.value : '';
                });
                reindexEntries();
            });
            entries.addEventListener('click', function (event) {
                const button = event.target.closest('[data-remove-expense]');
                if (!button) return;
                button.closest('.expense-entry').remove();
                reindexEntries();
            });
            entries.addEventListener('input', function (event) {
                if (event.target.matches('.expense-amount')) syncTotal(event.target);
            });
            entries.addEventListener('change', function (event) {
                if (event.target.matches('.expense-amount')) syncTotal(event.target);
            });
            const syncSharedFields = function (field) {
                if (!field.matches('.shared-expense-field')) return;
                const fieldName = field.name.split('.').pop();
                entries.querySelectorAll('[data-shared-field="' + fieldName + '"]').forEach(function (hiddenField) {
                    hiddenField.value = field.value;
                });
            };
            entries.addEventListener('input', function (event) { syncSharedFields(event.target); });
            entries.addEventListener('change', function (event) { syncSharedFields(event.target); });
            entries.querySelectorAll('.expense-amount').forEach(syncTotal);
            reindexEntries();
        })();
    </script>
}
