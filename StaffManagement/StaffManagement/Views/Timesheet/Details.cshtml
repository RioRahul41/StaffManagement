@model StaffManagement.Core.DTOs.TimesheetModel.TimesheetDto
@{
    ViewData["Title"] = "Timesheet details";
}
<h1>Timesheet details</h1>
<div class="card border-0 shadow-sm"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Employee</dt><dd class="col-sm-9">@Model.EmployeeName</dd>
        <dt class="col-sm-3">Project</dt><dd class="col-sm-9">@Model.ProjectName</dd>
        <dt class="col-sm-3">Task</dt><dd class="col-sm-9">@Model.TaskName</dd>
        <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
        <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Start</dt><dd class="col-sm-9">@DateTime.Today.Add(Model.StartTime).ToString("h:mm tt")</dd>
        <dt class="col-sm-3">End</dt><dd class="col-sm-9">@DateTime.Today.Add(Model.EndTime).ToString("h:mm tt")</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.Status == StaffManagement.Model.Enums.TimesheetStatus.InProgress ? "In Progress" : "Completed")</dd>
        <dt class="col-sm-3">Document</dt><dd class="col-sm-9">@if (!string.IsNullOrWhiteSpace(Model.DocumentPath)) { <a href="@Model.DocumentPath" target="_blank" rel="noopener">View document</a> } else { <span class="text-muted">None</span> }</dd>
    </dl>
</div></div>
<div class="mt-3">@if (User.IsInRole("Admin") || User.IsInRole("Manager") || (User.IsInRole("User") && !User.IsInRole("HR"))) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> } <a asp-action="Index" class="btn btn-secondary">Back</a></div>
