@model StaffManagement.Core.DTOs.TimesheetModel.CreateTimesheetDto
@using StaffManagement.Model.Enums
@{
    ViewData["Title"] = "Add timesheet";
    var canManage = User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Manager");
    var employees = ViewBag.Employees as IReadOnlyList<StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto> ?? [];
    var projects = ViewBag.Projects as IReadOnlyList<StaffManagement.Model.Entities.Project> ?? [];
}
<h1>Add timesheet</h1>
<p class="text-muted">Add one update per task. Start it as In Progress, then edit it later and mark it Completed.</p>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-3">
    @if (canManage)
    {
        <div class="col-md-6">
            <label asp-for="EmployeeId" class="form-label">Employee</label>
            <select asp-for="EmployeeId" class="form-select">
                <option value="">-- Select employee --</option>
                @foreach (var employee in employees)
                {
                    <option value="@employee.Id">@employee.FirstName @employee.LastName (@employee.Email)</option>
                }
            </select>
            <span asp-validation-for="EmployeeId" class="text-danger"></span>
        </div>
    }
    <div class="col-md-6">
        <label asp-for="ProjectId" class="form-label">Project</label>
        <span class="text-danger" aria-hidden="true">*</span>
        <select asp-for="ProjectId" class="form-select">
            <option value="">-- Select project --</option>
            @foreach (var project in projects)
            {
                <option value="@project.ProjectId">@project.ProjectName</option>
            }
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
        @if (projects.Count == 0 && !canManage)
        {
            <small class="text-danger">No current project is assigned. Ask your manager to assign one.</small>
        }
    </div>
    <div class="col-md-6"><label asp-for="TaskName" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="TaskName" class="form-control" /><span asp-validation-for="TaskName" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="Description" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="StartDate" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="StartDate" class="form-control" /><span asp-validation-for="StartDate" class="text-danger"></span></div>
    <div class="col-md-6">
        <label class="form-label" for="StartHour">Start time</label>
        <span class="text-danger" aria-hidden="true">*</span>

        <div class="time-input @(!ViewData.ModelState.IsValid ? "" : "")">
            <div class="input-group input-group-sm">
                <input asp-for="StartHour"
                       id="StartHour"
                       type="number"
                       min="1"
                       max="12"
                       step="1"
                       class="form-control"
                       placeholder="HH"
                       aria-label="Start hour" />

                <span class="input-group-text">:</span>

                <input asp-for="StartMinute"
                       id="StartMinute"
                       type="number"
                       min="0"
                       max="59"
                       step="1"
                       class="form-control"
                       placeholder="MM"
                       aria-label="Start minute" />

                <select asp-for="StartPeriod"
                        id="StartPeriod"
                        class="form-select"
                        aria-label="Start AM or PM">
                    <option value="AM">AM</option>
                    <option value="PM">PM</option>
                </select>
            </div>
        </div>

        <div class="mt-1">
            <span asp-validation-for="StartHour" class="text-danger small"></span>
            <span asp-validation-for="StartMinute" class="text-danger small"></span>
        </div>
    </div>
    <div class="col-md-6">
        <label class="form-label" for="EndHour">End time</label>
        <span class="text-danger" aria-hidden="true">*</span>

        <div class="time-input">
            <div class="input-group input-group-sm flex-nowrap">
                <input asp-for="EndHour"
                       id="EndHour"
                       type="number"
                       min="1"
                       max="12"
                       step="1"
                       class="form-control text-center"
                       placeholder="HH"
                       aria-label="End hour" />

                <span class="input-group-text time-separator">:</span>

                <input asp-for="EndMinute"
                       id="EndMinute"
                       type="number"
                       min="0"
                       max="59"
                       step="1"
                       class="form-control text-center"
                       placeholder="MM"
                       aria-label="End minute" />

                <select asp-for="EndPeriod"
                        id="EndPeriod"
                        class="form-select time-period"
                        aria-label="End AM or PM">
                    <option value="AM">AM</option>
                    <option value="PM">PM</option>
                </select>
            </div>
        </div>

        <div class="mt-1">
            <span asp-validation-for="EndHour" class="text-danger small"></span>
            <span asp-validation-for="EndMinute" class="text-danger small"></span>
        </div>
    </div>
    <div class="col-md-6"><label asp-for="Status" class="form-label">Work status</label><select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<TimesheetStatus>()"></select><span asp-validation-for="Status" class="text-danger"></span></div>
    <div class="col-md-6"><label class="form-label" for="document">Document</label><input class="form-control" type="file" id="document" name="document" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" /><div class="form-text">Optional. Maximum size: 10 MB.</div></div>
    <div class="col-12"><button class="btn btn-primary" type="submit">Save</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
