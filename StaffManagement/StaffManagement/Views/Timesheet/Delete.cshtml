@model StaffManagement.Core.DTOs.TimesheetModel.TimesheetDto
@{
    ViewData["Title"] = "Delete timesheet";
}
<h1>Delete timesheet</h1>
<div class="alert alert-warning">This action permanently deletes the timesheet record.</div>
<p>Delete the <strong>@Model.ProjectName</strong> timesheet for <strong>@Model.EmployeeName</strong> on <strong>@Model.StartDate.ToString("yyyy-MM-dd")</strong>?</p>
<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button class="btn btn-danger" type="submit">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
