@model IReadOnlyList<StaffManagement.Core.DTOs.TimesheetModel.TimesheetDto>
@{
    ViewData["Title"] = "Timesheets";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">TIME TRACKING</p>
        <h1 class="mb-1">Timesheets</h1>
        <p class="text-muted mb-0">Record and review project work.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add timesheet</a>
</div>
@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm"><div class="card-body text-center py-5"><h4>No timesheets found</h4><p class="text-muted">Add a timesheet to begin tracking work.</p><a asp-action="Create" class="btn btn-primary">Add timesheet</a></div></div>
}
else
{
    <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Employee</th><th>Project</th><th>Task</th><th>Description</th><th>Start</th><th>End</th><th>Status</th><th>Document</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var timesheet in Model)
        {
            <tr>
                <td>@timesheet.EmployeeName</td>
                <td>@timesheet.ProjectName</td>
                <td>@timesheet.TaskName</td>
                <td>@timesheet.Description</td>
                <td>@timesheet.StartDate.ToString("yyyy-MM-dd") @timesheet.StartTime.ToString(@"hh\:mm")</td>
                <td>@timesheet.EndTime.ToString(@"hh\:mm")</td>
                <td><span class="badge text-bg-secondary">@timesheet.Status</span></td>
                <td>@if (!string.IsNullOrWhiteSpace(timesheet.DocumentPath)) { <a href="@timesheet.DocumentPath" target="_blank" rel="noopener">View</a> } else { <span class="text-muted">-</span> }</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@timesheet.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@timesheet.Id" class="btn btn-sm btn-outline-primary ms-1">Edit</a>
                    <a asp-action="Delete" asp-route-id="@timesheet.Id" class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table></div></div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["Success"] is string success)
    {
        <script>Swal.fire({ icon: 'success', title: 'Success', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(success)), timer: 2200, showConfirmButton: false });</script>
    }
    @if (TempData["Error"] is string error)
    {
        <script>Swal.fire({ icon: 'error', title: 'Unable to complete action', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(error)) });</script>
    }
}
