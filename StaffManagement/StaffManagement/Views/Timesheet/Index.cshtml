@model IReadOnlyList<StaffManagement.Core.DTOs.TimesheetModel.TimesheetDto>
@{
    ViewData["Title"] = "Timesheets";
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Manager") || (User.IsInRole("User") && !User.IsInRole("HR"));
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">TIME TRACKING</p>
        <h1 class="mb-1">Timesheets</h1>
        <p class="text-muted mb-0">Record daily project work and see its current status.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add daily update</a>
</div>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm"><div class="card-body text-center py-5"><h4>No daily updates found</h4><p class="text-muted">Add a daily update to begin tracking work.</p><a asp-action="Create" class="btn btn-primary">Add daily update</a></div></div>
}
else
{
    <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Employee</th><th>Project</th><th>Task</th><th>Description</th><th>Date</th><th>Time</th><th>Status</th><th>Document</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var timesheet in Model)
        {
            <tr>
                <td>@timesheet.EmployeeName</td>
                <td>@timesheet.ProjectName</td>
                <td>@timesheet.TaskName</td>
                <td>@timesheet.Description</td>
                <td>@timesheet.StartDate.ToString("yyyy-MM-dd")</td>
                <td>@DateTime.Today.Add(timesheet.StartTime).ToString("h:mm tt") – @DateTime.Today.Add(timesheet.EndTime).ToString("h:mm tt")</td>
                <td><span class="badge @(timesheet.Status == StaffManagement.Model.Enums.TimesheetStatus.Completed ? "text-bg-success" : "text-bg-warning")">@(timesheet.Status == StaffManagement.Model.Enums.TimesheetStatus.InProgress ? "In Progress" : "Completed")</span></td>
                <td>@if (!string.IsNullOrWhiteSpace(timesheet.DocumentPath)) { <a href="@timesheet.DocumentPath" target="_blank" rel="noopener">View</a> } else { <span class="text-muted">-</span> }</td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@timesheet.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    @if (canEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@timesheet.Id" class="btn btn-sm btn-outline-primary ms-1">Edit</a>
                        <a asp-action="Delete" asp-route-id="@timesheet.Id" class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table></div></div>
}
