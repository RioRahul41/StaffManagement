@model StaffManagement.Core.DTOs.TimesheetModel.TimesheetDto
@using StaffManagement.Model.Enums

@{
    ViewData["Title"] = "Edit timesheet";
    var projects = ViewBag.Projects as IReadOnlyList<StaffManagement.Model.Entities.Project> ?? [];
}

<h1>Edit timesheet</h1>
<p class="text-muted">Update this task’s work notes, times, or status as the day progresses.</p>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="row g-3" novalidate>
    <input asp-for="Id" type="hidden" />
    <input asp-for="EmployeeId" type="hidden" />

    @* Optional: show only model-level errors, not individual field errors *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-12">
        <label class="form-label">Employee</label>
        <input value="@Model.EmployeeName" class="form-control" readonly />
    </div>

    <div class="col-md-6">
        <label asp-for="ProjectId" class="form-label">Project</label>
        <span class="text-danger" aria-hidden="true">*</span>
        <select asp-for="ProjectId" class="form-select">
            <option value="">-- Select project --</option>
            @foreach (var project in projects)
            {
                <option value="@project.ProjectId">@project.ProjectName</option>
            }
        </select>
        <span asp-validation-for="ProjectId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="TaskName" class="form-label">Task name</label>
        <span class="text-danger" aria-hidden="true">*</span>
        <input asp-for="TaskName" class="form-control" />
        <span asp-validation-for="TaskName" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label">Description</label>
        <span class="text-danger" aria-hidden="true">*</span>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="StartDate" class="form-label">Start date</label>
        <span class="text-danger" aria-hidden="true">*</span>
        <input asp-for="StartDate" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="StartTime" class="form-label">Start time</label>
        <span class="text-danger" aria-hidden="true">*</span>
        <select asp-for="StartTime" class="form-select time-input" required>
            @for (var minutes = 0; minutes < 24 * 60; minutes += 30)
            {
                var time = TimeSpan.FromMinutes(minutes);
                var hour = time.Hours % 12;
                if (hour == 0) hour = 12;
                var period = time.Hours < 12 ? "AM" : "PM";
                <option value="@time">@($"{hour}:{time.Minutes:00} {period}")</option>
            }
        </select>
        <span asp-validation-for="StartTime" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="EndTime" class="form-label">End time</label>
        <span class="text-danger" aria-hidden="true">*</span>
        <select asp-for="EndTime" class="form-select time-input" required>
            @for (var minutes = 0; minutes < 24 * 60; minutes += 30)
            {
                var time = TimeSpan.FromMinutes(minutes);
                var hour = time.Hours % 12;
                if (hour == 0) hour = 12;
                var period = time.Hours < 12 ? "AM" : "PM";
                <option value="@time">@($"{hour}:{time.Minutes:00} {period}")</option>
            }
        </select>
        <span asp-validation-for="EndTime" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Status" class="form-label">Work status</label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<TimesheetStatus>()"></select>
        <span asp-validation-for="Status" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label" for="document">Replace document</label>
        <input class="form-control" type="file" id="document" name="document"
               accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" />
        <div class="form-text">Optional. Maximum size: 10 MB.</div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.DocumentPath))
    {
        <div class="col-12">
            <a href="@Model.DocumentPath" target="_blank" rel="noopener">View current document</a>
        </div>
    }

    <div class="col-12">
        <button class="btn btn-primary" type="submit">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
