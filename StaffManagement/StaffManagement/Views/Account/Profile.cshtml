@model StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto
@{ ViewData["Title"] = "My profile"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">My profile</h1>
        <p class="text-muted mb-0">View your employee information.</p>
    </div>
    <a asp-action="EditProfile" class="btn btn-primary">Edit details</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="card profile-card">
    <div class="card-body">
        <div class="profile-heading mb-4">
            <div class="profile-avatar profile-avatar-lg">@Model.FirstName.FirstOrDefault()@Model.LastName.FirstOrDefault()</div>
            <div><h2 class="h4 mb-1">@Model.FirstName @Model.LastName</h2><div class="text-muted">@Model.Email</div></div>
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@(Model.Phone ?? "Not provided")</dd>
            <dt class="col-sm-3">Department</dt><dd class="col-sm-9">@(Model.Department ?? "Not assigned")</dd>
            <dt class="col-sm-3">Designation</dt><dd class="col-sm-9">@(Model.Designation ?? "Not assigned")</dd>
            <dt class="col-sm-3">Location</dt><dd class="col-sm-9">@Model.Location</dd>
            <dt class="col-sm-3">Date of birth</dt><dd class="col-sm-9">@(Model.DOB?.ToString("d") ?? "Not provided")</dd>
            <dt class="col-sm-3">Gender</dt><dd class="col-sm-9">@(Model.Gender?.ToString() ?? "Not provided")</dd>
        </dl>
    </div>
</div>
