@model StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto
@using StaffManagement.Model.Entities
@{ ViewData["Title"] = "My profile"; var profile = ViewBag.ProfileInformation as EmployeeProfile; var otherDetails = ViewBag.OtherDetails as IReadOnlyList<EmployeeOtherDetail> ?? Array.Empty<EmployeeOtherDetail>(); var qualifications = ViewBag.EmployeeQualifications as IReadOnlyList<EmployeeQualification> ?? Array.Empty<EmployeeQualification>(); var experiences = ViewBag.EmployeeExperiences as IReadOnlyList<EmployeeExperience> ?? Array.Empty<EmployeeExperience>(); var bankDetails = ViewBag.BankDetails as EmployeeBankDetail; }
<div class="mb-4"><h1 class="mb-1">My profile</h1><p class="text-muted mb-0">View and update your employee information.</p></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="row g-4 profile-view-page">
    <aside class="col-lg-3 col-xl-2"><nav class="nav nav-pills flex-column profile-section-menu" aria-label="Profile information sections">
        <button class="nav-link active text-start" type="button" data-bs-toggle="pill" data-bs-target="#personal-information" role="tab" aria-controls="personal-information" aria-selected="true"><span aria-hidden="true">♙</span> Personal Information <span class="ms-auto">›</span></button>
        <button class="nav-link text-start" type="button" data-bs-toggle="pill" data-bs-target="#profile-information" role="tab" aria-controls="profile-information" aria-selected="false"><span aria-hidden="true">▣</span> Profile Information <span class="ms-auto">›</span></button>
        <button class="nav-link text-start" type="button" data-bs-toggle="pill" data-bs-target="#address-information" role="tab" aria-controls="address-information" aria-selected="false"><span aria-hidden="true">⌖</span> Address Information <span class="ms-auto">›</span></button>
        <button class="nav-link text-start" type="button" data-bs-toggle="pill" data-bs-target="#other-details" role="tab" aria-controls="other-details" aria-selected="false"><span aria-hidden="true">▤</span> Other Details <span class="ms-auto">›</span></button>
        <button class="nav-link text-start" type="button" data-bs-toggle="pill" data-bs-target="#qualification-information" role="tab" aria-controls="qualification-information" aria-selected="false"><svg class="profile-section-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m2 9 10-5 10 5-10 5L2 9Z" /><path d="M6 11v5c3.5 2.7 8.5 2.7 12 0v-5m4-2v6" /></svg><span>Qualification Information</span><span class="ms-auto">›</span></button>
        <button class="nav-link text-start" type="button" data-bs-toggle="pill" data-bs-target="#experience-information" role="tab" aria-controls="experience-information" aria-selected="false"><span aria-hidden="true">▣</span> Experience Information <span class="ms-auto">›</span></button>
        <button class="nav-link text-start" type="button" data-bs-toggle="pill" data-bs-target="#bank-details" role="tab" aria-controls="bank-details" aria-selected="false"><span aria-hidden="true">▤</span> Bank Details <span class="ms-auto">›</span></button>
    </nav></aside>
    <main class="col-lg-9 col-xl-10"><div class="tab-content">
        <section class="tab-pane fade show active" id="personal-information" role="tabpanel"><div class="card profile-card"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-4"><div class="profile-heading">
                @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoPath)) { <img src="@Url.Action("ProfilePhoto")" alt="Profile photo" class="profile-avatar profile-avatar-lg" style="object-fit: cover;" /> }
                else { <div class="profile-avatar profile-avatar-lg">@Model.FirstName.FirstOrDefault()@Model.LastName.FirstOrDefault()</div> }
                <div><h2 class="h4 mb-1">Personal Information</h2><div class="text-muted">@Model.FirstName @Model.LastName</div></div>
            </div></div>
                        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 profile-info-grid">
                <div class="col"><div class="profile-info-item"><div class="profile-info-label">First name</div><div class="profile-info-value">@Model.FirstName</div></div></div>
                <div class="col"><div class="profile-info-item"><div class="profile-info-label">Last name</div><div class="profile-info-value">@Model.LastName</div></div></div>
                <div class="col"><div class="profile-info-item"><div class="profile-info-label">Office email</div><div class="profile-info-value">@Model.Email</div></div></div>
                <div class="col"><div class="profile-info-item"><div class="profile-info-label">Personal email</div><div class="profile-info-value">@(Model.PersonalEmail ?? "Not provided")</div></div></div>
                <div class="col"><div class="profile-info-item"><div class="profile-info-label">Designation</div><div class="profile-info-value">@(Model.Designation ?? "Not assigned")</div></div></div>
                <div class="col"><div class="profile-info-item"><div class="profile-info-label">Department</div><div class="profile-info-value">@(Model.Department ?? "Not assigned")</div></div></div>
                <div class="col"><div class="profile-info-item"><div class="profile-info-label">Skills</div><div class="profile-info-value">@(Model.Skills ?? "Not provided")</div></div></div>
                <div class="col"><div class="profile-info-item"><div class="profile-info-label">Reporting person</div><div class="profile-info-value">@(Model.ReportingPersonName ?? "Not assigned")</div></div></div>
                <div class="col"><div class="profile-info-item"><div class="profile-info-label">Phone</div><div class="profile-info-value">@(Model.Phone ?? "Not provided")</div></div></div>
                <div class="col"><div class="profile-info-item"><div class="profile-info-label">Location</div><div class="profile-info-value">@Model.Location</div></div></div>
            </div>
        </div></div></section>
        <section class="tab-pane fade" id="profile-information" role="tabpanel">
            <div class="card profile-card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Profile Information</h2>@if (profile is null) { <a asp-controller="EmployeeProfile" asp-action="Create" asp-route-employeeId="@Model.Id" asp-route-returnToProfile="true" class="btn btn-primary">Add</a> } else {  }</div>@if (profile is null) { <p class="text-muted mb-0">No profile information has been added yet.</p> } else { <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 profile-info-grid"><div class="col"><div class="profile-info-item"><div class="profile-info-label">Gender</div><div class="profile-info-value">@(profile.Gender?.ToString() ?? "Not provided")</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Marital status</div><div class="profile-info-value">@(profile.MaritalStatus ?? "Not provided")</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Date of birth</div><div class="profile-info-value">@(profile.DOB?.ToString("d") ?? "Not provided")</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Blood group</div><div class="profile-info-value">@(profile.BloodGroup ?? "Not provided")</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Phone number</div><div class="profile-info-value">@(profile.PhoneNumber ?? "Not provided")</div></div></div></div> }</div></div>
            <div class="card profile-card"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Emergency Contact Person</h2>@if (profile is null) { <a asp-controller="EmployeeProfile" asp-action="Create" asp-route-employeeId="@Model.Id" asp-route-returnToProfile="true" class="btn btn-primary">Add</a> }</div>@if (profile is null) { <p class="text-muted mb-0">No emergency contact has been added yet.</p> } else { <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 profile-info-grid"><div class="col"><div class="profile-info-item"><div class="profile-info-label">Name</div><div class="profile-info-value">@(profile.EmergencyContactName ?? "Not provided")</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Relationship</div><div class="profile-info-value">@(profile.EmergencyContactRelationship ?? "Not provided")</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Phone number</div><div class="profile-info-value">@(profile.EmergencyContactPhone ?? "Not provided")</div></div></div></div> }</div></div>
        </section>
        <section class="tab-pane fade" id="address-information" role="tabpanel"><div class="card profile-card"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Address Information</h2>@if (profile is null) { <a asp-controller="EmployeeProfile" asp-action="Create" asp-route-employeeId="@Model.Id" asp-route-returnToProfile="true" class="btn btn-primary">Add</a> }</div>@if (profile is null) { <p class="text-muted mb-0">No address information has been added yet.</p> } else { <div class="row g-4 profile-view-page">
    <div class="col-md-6"><h3 class="h5 mb-3">Permanent Address</h3><div class="row row-cols-1 row-cols-sm-2 g-3">
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Address Line 1</div><div class="profile-info-value">@(profile.PermanentAddressLine1 ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Address Line 2</div><div class="profile-info-value">@(profile.PermanentAddressLine2 ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Country</div><div class="profile-info-value">@(profile.PermanentCountry ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">State</div><div class="profile-info-value">@(profile.PermanentState ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">City</div><div class="profile-info-value">@(profile.PermanentCity ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Pin Code</div><div class="profile-info-value">@(profile.PermanentPincode ?? "Not provided")</div></div></div>
    </div></div>
    <div class="col-md-6"><h3 class="h5 mb-3">Current Address</h3><div class="row row-cols-1 row-cols-sm-2 g-3">
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Address Line 1</div><div class="profile-info-value">@(profile.CurrentAddressLine1 ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Address Line 2</div><div class="profile-info-value">@(profile.CurrentAddressLine2 ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Country</div><div class="profile-info-value">@(profile.CurrentCountry ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">State</div><div class="profile-info-value">@(profile.CurrentState ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">City</div><div class="profile-info-value">@(profile.CurrentCity ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Pin Code</div><div class="profile-info-value">@(profile.CurrentPincode ?? "Not provided")</div></div></div>
    </div></div>
</div> }</div></div></section>
        <section class="tab-pane fade" id="other-details" role="tabpanel">
            <div class="card profile-card"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Other Details</h2></div>
                @if (otherDetails.Count == 0)
                {
                    <p class="text-muted mb-0">No documents have been added yet.</p>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Document Type</th><th>Document Number</th><th>Valid From</th><th>Valid To</th><th class="text-end">Action</th></tr></thead><tbody>
                    @foreach (var document in otherDetails)
                    {
                        <tr><td>@document.DocumentType</td><td>@document.DocumentNumber</td><td>@(document.ValidFrom?.ToString("d") ?? "Not provided")</td><td>@(document.ValidTo?.ToString("d") ?? "Not provided")</td><td class="text-end"><a asp-controller="EmployeeOtherDetail" asp-action="Download" asp-route-id="@document.EmployeeOtherDetailId" class="btn btn-sm btn-outline-primary" title="Download document" aria-label="Download @document.DocumentType"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M.5 9.9v3.6c0 .8.7 1.5 1.5 1.5h12c.8 0 1.5-.7 1.5-1.5V9.9h-1.5v3.6H2V9.9z"/><path d="M7.25 0h1.5v8.1l2.3-2.3 1.1 1.1L8 11.05 3.85 6.9l1.1-1.1 2.3 2.3z"/></svg></a></td></tr>
                    }
                    </tbody></table></div>
                }
            </div></div>
        </section>        <section class="tab-pane fade" id="experience-information" role="tabpanel"><div class="card profile-card profile-experience-card"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Experience Information</h2></div>
        @if (experiences.Count == 0) { <p class="text-muted mb-0">No experience information has been added yet.</p> } else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Previous company</th><th>Date of joining</th><th>Date of relieving</th><th class="text-end">Action</th></tr></thead><tbody>@foreach (var item in experiences) { <tr><td>@item.PreviousCompany</td><td>@item.DateOfJoining?.ToString("d")</td><td>@item.DateOfRelieving?.ToString("d")</td><td class="text-end"><div class="dropdown"><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for @item.PreviousCompany">⋮</button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-controller="EmployeeExperience" asp-action="Details" asp-route-id="@item.EmployeeExperienceId" asp-route-returnToProfile="true">View</a></li></ul></div></td></tr> }</tbody></table></div> }</div></div></section>        <section class="tab-pane fade" id="bank-details" role="tabpanel"><div class="card profile-card profile-bank-card"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Bank Details</h2>@if (bankDetails is null) { <a asp-controller="EmployeeBankDetail" asp-action="Create" asp-route-employeeId="@Model.Id" class="btn btn-outline-primary">Add Bank Details</a> } else { <a asp-controller="EmployeeBankDetail" asp-action="Details" asp-route-employeeId="@Model.Id" asp-route-returnToProfile="true" class="btn btn-outline-secondary">View</a> }</div>
        @if (bankDetails is null) { <p class="text-muted mb-0">No bank details have been added yet.</p> } else { <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 profile-info-grid"><div class="col"><div class="profile-info-item"><div class="profile-info-label">Account holder name</div><div class="profile-info-value">@bankDetails.AccountHolderName</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Account name</div><div class="profile-info-value">@bankDetails.AccountName</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">IFSC code</div><div class="profile-info-value">@bankDetails.IFSCCode</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Branch</div><div class="profile-info-value">@bankDetails.Branch</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Account number</div><div class="profile-info-value">@bankDetails.AccountNumber</div></div></div></div> }
        </div></div></section>        <section class="tab-pane fade" id="qualification-information" role="tabpanel">
            <div class="card profile-card"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Qualification Information</h2></div>
                @if (qualifications.Count == 0) { <p class="text-muted mb-0">No qualification information has been added yet.</p> }
                else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Qualification</th><th>Institution Name</th><th>Percentage</th><th>Year of Passing</th><th class="text-end">Action</th></tr></thead><tbody>
                    @foreach (var item in qualifications) { <tr><td>@item.Qualification</td><td>@item.InstitutionName</td><td>@item.Percentage.ToString("0.##")%</td><td>@item.YearOfPassing</td><td class="text-end"><div class="dropdown"><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions" aria-label="Actions for @item.Qualification">⋮</button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-controller="EmployeeQualification" asp-action="Download" asp-route-id="@item.EmployeeQualificationId"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2" aria-hidden="true"><path d="M.5 9.9v3.6c0 .8.7 1.5 1.5 1.5h12c.8 0 1.5-.7 1.5-1.5V9.9h-1.5v3.6H2V9.9z"/><path d="M7.25 0h1.5v8.1l2.3-2.3 1.1 1.1L8 11.05 3.85 6.9l1.1-1.1 2.3 2.3z"/></svg>Download</a></li></ul></div></td></tr> }
                </tbody></table></div> }
            </div></div>
        </section>    </div></main>
</div>











