@model StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto
@using StaffManagement.Model.Entities
@{ ViewData["Title"] = "My profile"; var profile = ViewBag.ProfileInformation as EmployeeProfile; var otherDetails = ViewBag.OtherDetails as IReadOnlyList<EmployeeOtherDetail> ?? Array.Empty<EmployeeOtherDetail>(); }
<div class="mb-4"><h1 class="mb-1">My profile</h1><p class="text-muted mb-0">View and update your employee information.</p></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="row g-4">
    <aside class="col-lg-3 col-xl-2"><nav class="nav nav-pills flex-column profile-section-menu" aria-label="Profile information sections">
        <button class="nav-link active text-start" type="button" data-bs-toggle="pill" data-bs-target="#personal-information" role="tab" aria-controls="personal-information" aria-selected="true"><span aria-hidden="true">♙</span> Personal Information <span class="ms-auto">›</span></button>
        <button class="nav-link text-start" type="button" data-bs-toggle="pill" data-bs-target="#profile-information" role="tab" aria-controls="profile-information" aria-selected="false"><span aria-hidden="true">▣</span> Profile Information <span class="ms-auto">›</span></button>
        <button class="nav-link text-start" type="button" data-bs-toggle="pill" data-bs-target="#address-information" role="tab" aria-controls="address-information" aria-selected="false"><span aria-hidden="true">⌖</span> Address Information <span class="ms-auto">›</span></button>
        <button class="nav-link text-start" type="button" data-bs-toggle="pill" data-bs-target="#other-details" role="tab" aria-controls="other-details" aria-selected="false"><span aria-hidden="true">▤</span> Other Details <span class="ms-auto">›</span></button>
    </nav></aside>
    <main class="col-lg-9 col-xl-10"><div class="tab-content">
        <section class="tab-pane fade show active" id="personal-information" role="tabpanel"><div class="card profile-card"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-4"><div class="profile-heading">
                @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoPath)) { <img src="@Url.Action("ProfilePhoto")" alt="Profile photo" class="profile-avatar profile-avatar-lg" style="object-fit: cover;" /> }
                else { <div class="profile-avatar profile-avatar-lg">@Model.FirstName.FirstOrDefault()@Model.LastName.FirstOrDefault()</div> }
                <div><h2 class="h4 mb-1">Personal Information</h2><div class="text-muted">@Model.FirstName @Model.LastName</div></div>
            </div><a asp-action="EditProfile" class="btn btn-outline-primary">Edit</a></div>
            <dl class="row mb-0"><dt class="col-sm-3">First name</dt><dd class="col-sm-9">@Model.FirstName</dd><dt class="col-sm-3">Last name</dt><dd class="col-sm-9">@Model.LastName</dd><dt class="col-sm-3">Office email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Personal email</dt><dd class="col-sm-9">@(Model.PersonalEmail ?? "Not provided")</dd><dt class="col-sm-3">Designation</dt><dd class="col-sm-9">@(Model.Designation ?? "Not assigned")</dd><dt class="col-sm-3">Department</dt><dd class="col-sm-9">@(Model.Department ?? "Not assigned")</dd><dt class="col-sm-3">Skills</dt><dd class="col-sm-9">@(Model.Skills ?? "Not provided")</dd><dt class="col-sm-3">Reporting person</dt><dd class="col-sm-9">@(Model.ReportingPersonName ?? "Not assigned")</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@(Model.Phone ?? "Not provided")</dd><dt class="col-sm-3">Location</dt><dd class="col-sm-9">@Model.Location</dd></dl>
        </div></div></section>
        <section class="tab-pane fade" id="profile-information" role="tabpanel">
            <div class="card profile-card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Profile Information</h2>@if (profile is null) { <a asp-controller="EmployeeProfile" asp-action="Create" asp-route-employeeId="@Model.Id" asp-route-returnToProfile="true" class="btn btn-primary">Add</a> } else { <a asp-controller="EmployeeProfile" asp-action="Edit" asp-route-employeeId="@Model.Id" asp-route-section="profile" asp-route-returnToProfile="true" class="btn btn-outline-primary">Edit</a> }</div>@if (profile is null) { <p class="text-muted mb-0">No profile information has been added yet.</p> } else { <dl class="row mb-0"><dt class="col-sm-3">Gender</dt><dd class="col-sm-9">@(profile.Gender?.ToString() ?? "Not provided")</dd><dt class="col-sm-3">Marital status</dt><dd class="col-sm-9">@(profile.MaritalStatus ?? "Not provided")</dd><dt class="col-sm-3">Date of birth</dt><dd class="col-sm-9">@(profile.DOB?.ToString("d") ?? "Not provided")</dd><dt class="col-sm-3">Blood group</dt><dd class="col-sm-9">@(profile.BloodGroup ?? "Not provided")</dd><dt class="col-sm-3">Phone number</dt><dd class="col-sm-9">@(profile.PhoneNumber ?? "Not provided")</dd></dl> }</div></div>
            <div class="card profile-card"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Emergency Contact Person</h2>@if (profile is null) { <a asp-controller="EmployeeProfile" asp-action="Create" asp-route-employeeId="@Model.Id" asp-route-returnToProfile="true" class="btn btn-primary">Add</a> } else { <a asp-controller="EmployeeProfile" asp-action="Edit" asp-route-employeeId="@Model.Id" asp-route-section="emergency" asp-route-returnToProfile="true" class="btn btn-outline-primary">Edit</a> }</div>@if (profile is null) { <p class="text-muted mb-0">No emergency contact has been added yet.</p> } else { <dl class="row mb-0"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@(profile.EmergencyContactName ?? "Not provided")</dd><dt class="col-sm-3">Relationship</dt><dd class="col-sm-9">@(profile.EmergencyContactRelationship ?? "Not provided")</dd><dt class="col-sm-3">Phone number</dt><dd class="col-sm-9">@(profile.EmergencyContactPhone ?? "Not provided")</dd></dl> }</div></div>
        </section>
        <section class="tab-pane fade" id="address-information" role="tabpanel"><div class="card profile-card"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Address Information</h2>@if (profile is null) { <a asp-controller="EmployeeProfile" asp-action="Create" asp-route-employeeId="@Model.Id" asp-route-returnToProfile="true" class="btn btn-primary">Add</a> } else { <a asp-controller="EmployeeProfile" asp-action="Edit" asp-route-employeeId="@Model.Id" asp-route-section="address" asp-route-returnToProfile="true" class="btn btn-outline-primary">Edit</a> }</div>@if (profile is null) { <p class="text-muted mb-0">No address information has been added yet.</p> } else { <div class="row g-4">
    <div class="col-md-6"><h3 class="h5 mb-3">Permanent Address</h3><div class="row g-3">
        <div class="col-12"><div class="small text-muted">Address Line 1</div><div>@(profile.PermanentAddressLine1 ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">Address Line 2</div><div>@(profile.PermanentAddressLine2 ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">Country</div><div>@(profile.PermanentCountry ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">State</div><div>@(profile.PermanentState ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">City</div><div>@(profile.PermanentCity ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">Pin Code</div><div>@(profile.PermanentPincode ?? "Not provided")</div></div>
    </div></div>
    <div class="col-md-6"><h3 class="h5 mb-3">Current Address</h3><div class="row g-3">
        <div class="col-12"><div class="small text-muted">Address Line 1</div><div>@(profile.CurrentAddressLine1 ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">Address Line 2</div><div>@(profile.CurrentAddressLine2 ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">Country</div><div>@(profile.CurrentCountry ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">State</div><div>@(profile.CurrentState ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">City</div><div>@(profile.CurrentCity ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">Pin Code</div><div>@(profile.CurrentPincode ?? "Not provided")</div></div>
    </div></div>
</div> }</div></div></section>
        <section class="tab-pane fade" id="other-details" role="tabpanel">
            <div class="card profile-card"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Other Details</h2><a asp-controller="EmployeeOtherDetail" asp-action="Create" asp-route-employeeId="@Model.Id" asp-route-returnToProfile="true" class="btn btn-outline-primary">Add Document</a></div>
                @if (otherDetails.Count == 0)
                {
                    <p class="text-muted mb-0">No documents have been added yet.</p>
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Document Type</th><th>Document Number</th><th>Valid From</th><th>Valid To</th><th class="text-end">Action</th></tr></thead><tbody>
                    @foreach (var document in otherDetails)
                    {
                        <tr><td>@document.DocumentType</td><td>@document.DocumentNumber</td><td>@(document.ValidFrom?.ToString("d") ?? "Not provided")</td><td>@(document.ValidTo?.ToString("d") ?? "Not provided")</td><td class="text-end"><a asp-controller="EmployeeOtherDetail" asp-action="Download" asp-route-id="@document.EmployeeOtherDetailId" class="btn btn-sm btn-outline-primary" title="Download document" aria-label="Download @document.DocumentType"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M.5 9.9v3.6c0 .8.7 1.5 1.5 1.5h12c.8 0 1.5-.7 1.5-1.5V9.9h-1.5v3.6H2V9.9z"/><path d="M7.25 0h1.5v8.1l2.3-2.3 1.1 1.1L8 11.05 3.85 6.9l1.1-1.1 2.3 2.3z"/></svg></a></td></tr>
                    }
                    </tbody></table></div>
                }
            </div></div>
        </section>    </div></main>
</div>





