@using Microsoft.AspNetCore.Mvc.Rendering

@model StaffManagement.Core.DTOs.EmployeeModel.CreateAccountDto
@{
    ViewData["Title"] = "Create employee account";
    var roles = ViewBag.Roles as IReadOnlyList<string> ?? [];
    var designations = ViewBag.Designations as IReadOnlyList<StaffManagement.Model.Entities.Designation> ?? [];
    var departments = ViewBag.Departments as IEnumerable<StaffManagement.Model.Entities.Department> ?? [];
    var managers = ViewBag.Managers as IReadOnlyList<StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto> ?? [];
}
<h1>Create employee account</h1>
<p class="text-muted">The account and linked employee record are created together.</p>
<form asp-action="Create" method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="10" pattern="[0-9]{10}" data-phone-number placeholder="10-digit number" aria-describedby="Phone-hint" class="form-control" />
        <div id="Phone-hint" class="form-text">Optional. If entered, use exactly 10 digits.</div>
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-6"><label asp-for="Password" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="ConfirmPassword" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="ConfirmPassword" class="form-control" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="Role" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><select asp-for="Role" class="form-select"><option value="">Select role</option>@foreach (var role in roles) { <option value="@role">@role</option> }</select><span asp-validation-for="Role" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="ReportingPersonId" class="form-label">Reporting person</label><span id="reporting-person-required" class="text-danger" aria-hidden="true" hidden>*</span><select asp-for="ReportingPersonId" class="form-select"><option value="">-- Select reporting person --</option>@foreach (var manager in managers) { <option value="@manager.Id">@manager.FirstName @manager.LastName (@manager.Email)</option> }</select><span asp-validation-for="ReportingPersonId" class="text-danger"></span><div class="form-text">Select an active Admin, HR, or Manager. Required when creating a User account.</div></div>
    <div class="col-md-4"><label asp-for="DepartmentId" class="form-label">Department</label><span class="text-danger" aria-hidden="true">*</span><select asp-for="DepartmentId" class="form-select" asp-items="@(new SelectList(ViewBag.Departments, "DepartmentId", "DepartmentName", Model.DepartmentId))"><option value="">-- Select Department --</option></select><span asp-validation-for="DepartmentId" class="text-danger"></span></div>
    
    <div class="col-md-4">
        <label asp-for="Designation" class="form-label"></label>
        <select asp-for="Designation" class="form-select">
            <option value="">Select designation</option>
            @foreach (var designation in designations) 
            { 
                <option value="@designation.DesignationName">@designation.DesignationName</option> 
            }
        </select>
    </div>
    <div class="col-md-6"><label asp-for="Location" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger"></span></div>
    <div class="col-12"><h2 class="h5 mb-0">Annual leave allowances</h2><p class="text-muted mb-0">Pending requests reserve days. Approved requests count as used.</p></div>
    <div class="col-md-4"><label asp-for="SickLeaveAllowance" class="form-label">Sick leave days</label><input asp-for="SickLeaveAllowance" class="form-control" min="0" max="365" /><span asp-validation-for="SickLeaveAllowance" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="CasualLeaveAllowance" class="form-label">Casual leave days</label><input asp-for="CasualLeaveAllowance" class="form-control" min="0" max="365" /><span asp-validation-for="CasualLeaveAllowance" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="DOB" class="form-label"></label><input asp-for="DOB" class="form-control" /></div>
    <div class="col-12"><button type="submit" class="btn btn-primary">Create account</button> <a asp-controller="Employee" asp-action="Index" class="btn btn-secondary">Cancel</a></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const role = document.getElementById('@Html.IdFor(model => model.Role)');
            const reportingPersonRequired = document.getElementById('reporting-person-required');
            const updateReportingPersonRequired = () => {
                reportingPersonRequired.hidden = role.value !== 'User';
            };
            role.addEventListener('change', updateReportingPersonRequired);
            updateReportingPersonRequired();
        })();
    </script>
}
