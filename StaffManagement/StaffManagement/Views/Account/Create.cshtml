@using Microsoft.AspNetCore.Mvc.Rendering
@using StaffManagement.Core.Security

@model StaffManagement.Core.DTOs.EmployeeModel.CreateAccountDto
@{
    ViewData["Title"] = "Create employee account";
    var roles = ViewBag.Roles as IReadOnlyList<string> ?? [];
    var designations = ViewBag.Designations as IReadOnlyList<StaffManagement.Model.Entities.Designation> ?? [];
    var departments = ViewBag.Departments as IEnumerable<StaffManagement.Model.Entities.Department> ?? [];
    var managers = ViewBag.Managers as IReadOnlyList<StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto> ?? [];
    var reportingPersonRoles = ViewBag.ReportingPersonRoles as IReadOnlyDictionary<int, string> ?? new Dictionary<int, string>();
}
<h1>Create employee account</h1>
<p class="text-muted">The account and linked employee record are created together.</p>
<form asp-action="Create" method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="10" pattern="[0-9]{10}" data-phone-number placeholder="10-digit number" aria-describedby="Phone-hint" class="form-control" />
        <div id="Phone-hint" class="form-text">Optional. If entered, use exactly 10 digits.</div>
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Password" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span>
        <div class="input-group">
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <button type="button" class="btn btn-outline-secondary toggle-password" data-password-target="Password" aria-label="Show password" aria-pressed="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5Z" />
                    <circle cx="8" cy="8" r="2" />
                    <line class="password-eye-slash" x1="2" y1="14" x2="14" y2="2" stroke="currentColor" stroke-width="1.5" style="display:none" />
                </svg>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ConfirmPassword" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span>
        <div class="input-group">
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <button type="button" class="btn btn-outline-secondary toggle-password" data-password-target="ConfirmPassword" aria-label="Show confirm password" aria-pressed="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5Z" />
                    <circle cx="8" cy="8" r="2" />
                    <line class="password-eye-slash" x1="2" y1="14" x2="14" y2="2" stroke="currentColor" stroke-width="1.5" style="display:none" />
                </svg>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Role" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span>
        <select asp-for="Role" class="form-select">
            <option value="">Select role</option>
            @foreach (var role in roles)
            {
                var allowance = RoleLeavePolicy.For(role);
                <option value="@role" data-sick-days="@allowance.Sick" data-casual-days="@allowance.Casual">@role</option>
            }
        </select>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>
    <div class="col-md-6"><label asp-for="ReportingPersonId" class="form-label">Reporting person</label><span id="reporting-person-required" class="text-danger" aria-hidden="true" hidden>*</span><select asp-for="ReportingPersonId" class="form-select"><option value="">-- Select reporting person --</option>@foreach (var manager in managers) { var managerRole = reportingPersonRoles.TryGetValue(manager.Id, out var assignedRole) ? assignedRole : ""; <option value="@manager.Id" data-reporting-role="@managerRole">@manager.FirstName @manager.LastName (@managerRole) (@manager.Email)</option> }</select><span asp-validation-for="ReportingPersonId" class="text-danger"></span><div id="reporting-person-help" class="form-text">HR and Managers report to Admin; Users report to HR or Manager.</div></div>
    <div class="col-md-4"><label asp-for="DepartmentId" class="form-label">Department</label><span class="text-danger" aria-hidden="true">*</span><select asp-for="DepartmentId" class="form-select" asp-items="@(new SelectList(ViewBag.Departments, "DepartmentId", "DepartmentName", Model.DepartmentId))"><option value="">-- Select Department --</option></select><span asp-validation-for="DepartmentId" class="text-danger"></span></div>
    
    <div class="col-md-4">
        <label asp-for="Designation" class="form-label"></label>
        <select asp-for="Designation" class="form-select">
            <option value="">Select designation</option>
            @foreach (var designation in designations) 
            { 
                <option value="@designation.DesignationName">@designation.DesignationName</option> 
            }
        </select>
    </div>
    <div class="col-md-6"><label asp-for="Location" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger"></span></div>
    <div class="col-12"><h2 class="h5 mb-0">Annual leave allowances</h2><p class="text-muted mb-0">Pending requests reserve days. Approved requests count as used.</p></div>
    <div class="col-md-4"><label asp-for="SickLeaveAllowance" class="form-label">Sick leave days</label><input asp-for="SickLeaveAllowance" class="form-control" min="0" max="365" readonly /><span asp-validation-for="SickLeaveAllowance" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="CasualLeaveAllowance" class="form-label">Casual leave days</label><input asp-for="CasualLeaveAllowance" class="form-control" min="0" max="365" readonly /><span asp-validation-for="CasualLeaveAllowance" class="text-danger"></span></div>
    <div class="col-12"><button type="submit" class="btn btn-primary">Create account</button> <a asp-controller="Employee" asp-action="Index" class="btn btn-secondary">Cancel</a></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            document.querySelectorAll('.toggle-password[data-password-target]').forEach(button => {
                button.addEventListener('click', () => {
                    const input = document.getElementById(button.dataset.passwordTarget);
                    const isVisible = input.type === 'text';
                    input.type = isVisible ? 'password' : 'text';
                    button.setAttribute('aria-label', `${isVisible ? 'Show' : 'Hide'} ${input.labels[0].textContent.trim()}`);
                    button.setAttribute('aria-pressed', String(!isVisible));
                    button.querySelector('.password-eye-slash').style.display = isVisible ? 'none' : 'block';
                });
            });

            const role = document.getElementById('@Html.IdFor(model => model.Role)');
            const sickAllowance = document.getElementById('@Html.IdFor(model => model.SickLeaveAllowance)');
            const casualAllowance = document.getElementById('@Html.IdFor(model => model.CasualLeaveAllowance)');
            const reportingPersonRequired = document.getElementById('reporting-person-required');
            const reportingPerson = document.getElementById('@Html.IdFor(model => model.ReportingPersonId)');
            const reportingPersonHelp = document.getElementById('reporting-person-help');
            const allowedReportingRoles = {
                'HR': ['Admin'],
                'Manager': ['Admin'],
                'User': ['HR', 'Manager'],
                'Technical Support': ['Admin']
            };
            const updateReportingPersonOptions = () => {
                const allowed = allowedReportingRoles[role.value] || [];
                const required = ['HR', 'Manager', 'User', 'Technical Support'].includes(role.value);
                reportingPerson.required = required;
                reportingPersonRequired.hidden = !required;
                Array.from(reportingPerson.options).forEach(option => {
                    if (!option.value) return;
                    const visible = allowed.includes(option.dataset.reportingRole);
                    option.hidden = !visible;
                    option.disabled = !visible;
                    if (!visible && option.selected) reportingPerson.value = '';
                });
                reportingPersonHelp.textContent = role.value === 'HR' || role.value === 'Manager'
                    ? 'HR and Managers must report to an Admin.'
                    : role.value === 'User'
                        ? 'Users must report to an HR or Manager.'
                        : role.value === 'Technical Support'
                            ? 'Technical Support must report to an Admin.'
                            : role.value === 'Admin'
                            ? 'Admin accounts do not have a reporting person.'
                            : 'No reporting person is assigned for this role.';
            };
            const updateLeaveAllowances = () => {
                const selectedRole = role.selectedOptions[0];
                sickAllowance.value = selectedRole?.dataset.sickDays || '0';
                casualAllowance.value = selectedRole?.dataset.casualDays || '0';
            };
            role.addEventListener('change', updateReportingPersonOptions);
            role.addEventListener('change', updateLeaveAllowances);
            updateReportingPersonOptions();
            updateLeaveAllowances();
        })();
    </script>
}

