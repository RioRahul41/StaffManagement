@model IReadOnlyList<StaffManagement.Model.Entities.Project>

@{ ViewData["Title"] = "Projects"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">@(User.IsInRole("User") ? "My Assigned Projects" : "Projects")</h1>
        <p class="text-muted mb-0">@(User.IsInRole("Manager") || User.IsInRole("Admin") ? "Manage projects and current employee assignments." : User.IsInRole("HR") ? "View active organization projects." : "View projects assigned to you.")</p>
    </div>
    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Project</a>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <h5>@(User.IsInRole("User") ? "No projects assigned" : "No projects found")</h5>
                <p class="text-muted">@(User.IsInRole("User") ? "Ask your manager to assign projects to your employee profile." : "Create the first project to get started.")</p>
                @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="btn btn-primary">Create Project</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Project</th><th>Description</th><th>Timeline</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var project in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@project.ProjectName</td>
                            <td>@(string.IsNullOrWhiteSpace(project.Description) ? "—" : project.Description)</td>
                            <td>@(project.StartDate?.ToString("MMM dd, yyyy") ?? "—") – @(project.EndDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                            <td><span class="badge @(project.IsActive ? "text-bg-success" : "text-bg-secondary")">@(project.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Detail" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-info me-1">Details</a>
                                @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@project.ProjectId" method="post" class="d-inline delete-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["SuccessMessage"] is string)
    {
        <script>Swal.fire({ icon: 'success', title: 'Success', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"])), timer: 2200, showConfirmButton: false });</script>
    }
    <script>
        document.querySelectorAll('.delete-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                Swal.fire({ title: 'Delete this project?', text: 'The project will be deactivated.', icon: 'warning', showCancelButton: true, confirmButtonColor: '#dc3545', cancelButtonColor: '#6c757d', confirmButtonText: 'Yes, delete it', cancelButtonText: 'Cancel' })
                    .then(function (result) { if (result.isConfirmed) form.submit(); });
            });
        });
    </script>
}
