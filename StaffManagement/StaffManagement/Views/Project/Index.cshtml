@model IReadOnlyList<StaffManagement.Model.Entities.Project>

@{ ViewData["Title"] = "Projects"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">@(User.IsInRole("User") ? "My Assigned Projects" : "Projects")</h1>
        <p class="text-muted mb-0">@(User.IsInRole("Manager") || User.IsInRole("Admin") ? "Manage projects and current employee assignments." : User.IsInRole("HR") ? "View active organization projects." : "View projects assigned to you.")</p>
    </div>
    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Project</a>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <h5>@(User.IsInRole("User") ? "No projects assigned" : "No projects found")</h5>
                <p class="text-muted">@(User.IsInRole("User") ? "Ask your manager to assign projects to your employee profile." : "Create the first project to get started.")</p>
                @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="btn btn-primary">Create Project</a>
                }
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-sm-6 col-md-4">
                            <label for="projectStatusFilter" class="form-label">Filter by project status</label>
                            <select id="projectStatusFilter" class="form-select">
                                <option value="">All project statuses</option>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                        <div class="col-sm-6 col-md-8">
                            <button id="projectResetSearch" type="button" class="btn btn-outline-secondary">Reset search</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table id="projectTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th class="text-center">S.No.</th><th>Project</th><th>Description</th><th>Timeline</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var project in Model.Select((item, index) => new { Item = item, Index = index + 1 }))
                    {
                        <tr>
                            <td class="text-center">@project.Index</td>
                            <td class="fw-semibold">@project.Item.ProjectName</td>
                            <td>@(string.IsNullOrWhiteSpace(project.Item.Description) ? "—" : project.Item.Description)</td>
                            <td>@(project.Item.StartDate?.ToString("MMM dd, yyyy") ?? "—") – @(project.Item.EndDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                            <td><span class="badge @(project.Item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(project.Item.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end text-nowrap">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Project actions">⋮</button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a asp-action="Detail" asp-route-id="@project.Item.ProjectId" class="dropdown-item">Details</a></li>
                                        @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                                        {
                                            <li><a asp-action="Edit" asp-route-id="@project.Item.ProjectId" class="dropdown-item">Edit</a></li>
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@project.Item.ProjectId" method="post" class="delete-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-danger">Delete</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.css" />
}

@section Scripts {
    <script src="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.js"></script>
    <script>
        if (document.querySelector('#projectTable')) {
            const projectTable = new DataTable('#projectTable', {
                pageLength: 10,
                lengthChange: true,
                autoWidth: false,
                columnDefs: [{ targets: [0, -1], orderable: false, searchable: false }],
                drawCallback: function () {
                    const api = this.api();
                    const pageStart = api.page.info().start;
                    api.column(0, { page: 'current', order: 'applied', search: 'applied' }).nodes().each(function (cell, index) {
                        cell.textContent = pageStart + index + 1;
                    });
                }
            });

            document.getElementById('projectStatusFilter').addEventListener('change', function () {
                const value = this.value;
                projectTable.column(4).search(value ? '^' + value + '$' : '', true, false).draw();
            });
            document.getElementById('projectResetSearch').addEventListener('click', function () {
                document.getElementById('projectStatusFilter').value = '';
                projectTable.search('').columns().search('').draw();
                const searchInput = document.querySelector('#projectTable_wrapper .dt-search input');
                if (searchInput) searchInput.value = '';
            });
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["SuccessMessage"] is string)
    {
        <script>Swal.fire({ icon: 'success', title: 'Success', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"])), timer: 2200, showConfirmButton: false });</script>
    }
    <script>
        document.querySelectorAll('.delete-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                Swal.fire({ title: 'Delete this project?', text: 'The project will be deactivated.', icon: 'warning', showCancelButton: true, confirmButtonColor: '#dc3545', cancelButtonColor: '#6c757d', confirmButtonText: 'Yes, delete it', cancelButtonText: 'Cancel' })
                    .then(function (result) { if (result.isConfirmed) form.submit(); });
            });
        });
    </script>
}
