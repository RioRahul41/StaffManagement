@model IReadOnlyList<StaffManagement.Core.DTOs.DocumentTypeModel.DocumentTypeDto>
@{ ViewData["Title"] = "Document Types"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="mb-1">Document Types</h1><p class="text-muted mb-0">Manage the document options and their validity date rules.</p></div>
    <a asp-action="Create" class="btn btn-primary">Add Document Type</a>
</div>

<div class="card profile-card"><div class="card-body">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No document types have been created.</p>
    }
    else
    {
        <div class="table-responsive"><table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Document Type</th><th>Validity Dates</th><th>Status</th><th>Created</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.DocumentTypeName</td>
                    <td>@(item.RequiresValidityDates ? "Required" : "Not used")</td>
                    <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                    <td>@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Actions" aria-label="Actions for @item.DocumentTypeName">⋮</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a asp-action="Edit" asp-route-id="@item.DocumentTypeId" class="dropdown-item"><span aria-hidden="true">✎</span> Edit</a></li>
                                @if (item.IsActive)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><form asp-action="Deactivate" asp-route-id="@item.DocumentTypeId" method="post" class="deactivate-form"><button type="submit" class="dropdown-item text-danger"><span aria-hidden="true">⌫</span> Delete</button></form></li>
                                }
                            </ul>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</div></div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.querySelectorAll('.deactivate-form').forEach(form => form.addEventListener('submit', event => {
    event.preventDefault();
    Swal.fire({ title: 'Delete this document type?', text: 'It will be marked inactive and removed from employee document forms.', icon: 'warning', showCancelButton: true, confirmButtonColor: '#dc3545', confirmButtonText: 'Yes, delete', cancelButtonText: 'Cancel' })
        .then(result => { if (result.isConfirmed) form.submit(); });
}));
</script>
@if (TempData["SuccessMessage"] is string successMessage)
{
    <script>Swal.fire({ icon: 'success', title: 'Success', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)), timer: 2200, showConfirmButton: false });</script>
}
