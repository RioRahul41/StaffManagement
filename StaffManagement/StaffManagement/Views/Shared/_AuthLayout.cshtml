<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StaffManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <main class="min-vh-100 d-flex align-items-center justify-content-center p-3">
        <div class="row w-100 shadow rounded-4 overflow-hidden bg-white" style="max-width: 960px;">
            <section class="col-lg-5 d-none d-lg-flex flex-column justify-content-center bg-primary text-white p-5">
                <h1 class="display-6 fw-bold">StaffManagement</h1>
                <p class="lead">Secure employee management for every team.</p>
                <ul class="mt-3 ps-3">
                    <li>Role-based access</li>
                    <li>Identity-backed employee accounts</li>
                    <li>Centralized employee records</li>
                </ul>
            </section>
            <section class="col-lg-7 p-4 p-md-5">
                @RenderBody()
            </section>
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
