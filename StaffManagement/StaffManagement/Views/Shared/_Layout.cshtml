@using Microsoft.AspNetCore.Identity
@inject UserManager<StaffManagement.Model.Entities.ApplicationIdentity> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StaffManagement</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StaffManagement.styles.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">
            <aside class="app-sidebar">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Index">StaffManagement</a>
                <div class="sidebar-user">
                    <span class="badge bg-primary">@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("HR") ? "HR" : User.IsInRole("Manager") ? "Manager" : "User")</span>
                    <span class="sidebar-user-name">@User.Identity.Name</span>
                </div>
                @{ var currentController = ViewContext.RouteData.Values["controller"]?.ToString(); }
                <nav class="sidebar-nav" aria-label="Main navigation">
                    <a class="sidebar-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" /></svg><span>Dashboard</span>
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                    {
                        <details class="sidebar-group" open="@(currentController is "Employee" or "Department" or "Designation" or "Account" ? "open" : null)">
                            <summary class="sidebar-group-toggle">
                                <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg><span>People</span><svg class="sidebar-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
                            </summary>
                            <div class="sidebar-submenu">
                                <a class="sidebar-link @(currentController == "Employee" ? "active" : "")" asp-controller="Employee" asp-action="Index"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="4" /><path d="M2 21a7 7 0 0 1 14 0M19 8v6m3-3h-6" /></svg><span>Employees</span></a>
                                <a class="sidebar-link @(currentController == "Department" ? "active" : "")" asp-controller="Department" asp-action="Index"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2" /><path d="M9 21V9h6v12M7 8h.01M17 8h.01M7 12h.01M17 12h.01" /></svg><span>Departments</span></a>
                                <a class="sidebar-link @(currentController == "Designation" ? "active" : "")" asp-controller="Designation" asp-action="Index"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 3 8l9 5 9-5-9-5ZM5 10v6l7 4 7-4v-6M21 8v8" /></svg><span>Designations</span></a>
                                <a class="sidebar-link @(currentController == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" asp-controller="Account" asp-action="Create"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14m-7-7h14" /></svg><span>Create account</span></a>
                            </div>
                        </details>
                    }
                    else if (User.IsInRole("Manager"))
                    {
                        <details class="sidebar-group" open="@(currentController == "Employee" ? "open" : null)">
                            <summary class="sidebar-group-toggle"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg><span>People</span><svg class="sidebar-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
                            <div class="sidebar-submenu"><a class="sidebar-link @(currentController == "Employee" ? "active" : "")" asp-controller="Employee" asp-action="Index"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="4" /><path d="M2 21a7 7 0 0 1 14 0M19 8v6m3-3h-6" /></svg><span>Team records</span></a></div>
                        </details>
                    }
                    else
                    {
                        <details class="sidebar-group" open="@(currentController == "Employee" ? "open" : null)">
                            <summary class="sidebar-group-toggle"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg><span>People</span><svg class="sidebar-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
                            <div class="sidebar-submenu"><a class="sidebar-link @(currentController == "Employee" ? "active" : "")" asp-controller="Employee" asp-action="Index"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="4" /><path d="M2 21a7 7 0 0 1 14 0M19 8v6m3-3h-6" /></svg><span>Staff directory</span></a></div>
                        </details>
                    }
                    <details class="sidebar-group" open="@(currentController == "Project" || currentController == "Timesheet" ? "open" : null)">
                        <summary class="sidebar-group-toggle"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M8 2v4m8-4v4M3 10h18M8 14h2m4 0h2m-8 3h2" /></svg><span>Work</span><svg class="sidebar-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
                        <div class="sidebar-submenu">
                            <a class="sidebar-link @(currentController == "Project" ? "active" : "")" asp-controller="Project" asp-action="Index"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="M3 10h18" /></svg><span>@(User.IsInRole("User") ? "My projects" : "Projects")</span></a>
                            <a class="sidebar-link @(currentController == "Timesheet" ? "active" : "")" asp-controller="Timesheet" asp-action="Index"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg><span>Timesheets</span></a>
                        </div>
                    </details>
                    <details class="sidebar-group" open="@(currentController == "Expense" || currentController == "Leave" ? "open" : null)">
                        <summary class="sidebar-group-toggle"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z" /><path d="M9 12h6m-3-3v6" /></svg><span>Requests</span><svg class="sidebar-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
                        <div class="sidebar-submenu">
                            <a class="sidebar-link @(currentController == "Expense" ? "active" : "")" asp-controller="Expense" asp-action="Index"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20m-15 4h3" /></svg><span>Expenses</span></a>
                            <a class="sidebar-link @(currentController == "Leave" ? "active" : "")" asp-controller="Leave" asp-action="Index"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2" /><path d="M16 2v4M8 2v4M3 10h18m-12 4h6m-6 3h4" /></svg><span>Leave</span></a>
                        </div>
                    </details>
                    <details class="sidebar-group" open="@(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Privacy" ? "open" : null)">
                        <summary class="sidebar-group-toggle"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3m.1 4h.01" /></svg><span>Help &amp; information</span><svg class="sidebar-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg></summary>
                        <div class="sidebar-submenu"><a class="sidebar-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Privacy" ? "active" : "")" asp-controller="Home" asp-action="Privacy"><svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z" /><path d="m9 12 2 2 4-4" /></svg><span>Privacy</span></a></div>
                    </details>
                </nav>
                <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout">
                    <button type="submit" class="btn btn-outline-light w-100">Logout</button>
                </form>
            </aside>
            <main class="app-content">
                <header class="topbar d-flex justify-content-end align-items-center px-4 py-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var displayName = currentUser is null ? User.Identity.Name : $"{currentUser.FirstName} {currentUser.LastName}";
                        var displayEmail = currentUser?.Email ?? User.Identity.Name;
                        var initials = currentUser is null
                            ? (User.Identity.Name is { Length: > 0 } name ? name[..1] : "U")
                            : $"{currentUser.FirstName.FirstOrDefault()}{currentUser.LastName.FirstOrDefault()}";
                        <div class="dropdown">
                            <button class="profile-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="profile-avatar">@initials.ToUpperInvariant()</span>
                                <span class="profile-trigger-text d-none d-sm-block text-start">
                                    <strong>@displayName</strong>
                                    <small>@displayEmail</small>
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end profile-menu">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-semibold">@displayName</div>
                                    <small class="text-muted">@displayEmail</small>
                                </li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">View profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="EditProfile">Edit details</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change password</a></li>
                                <li><button type="button" class="dropdown-item" id="darkModeToggle"><span id="darkModeLabel">Dark mode</span></button></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </header>
                <div class="container-fluid px-4 pb-4">
                    @RenderBody()
                </div>
            </main>
        </div>
    }
    else
    {
        <header class="border-bottom bg-white">
            <nav class="navbar container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">StaffManagement</a>
                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
            </nav>
        </header>
        <main class="container py-4">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
