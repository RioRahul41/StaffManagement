<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StaffManagement</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StaffManagement.styles.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">
            <aside class="app-sidebar">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Index">StaffManagement</a>
                <div class="sidebar-user">
                    <span class="badge bg-primary">@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("HR") ? "HR" : User.IsInRole("Manager") ? "Manager" : "User")</span>
                    <span class="sidebar-user-name">@User.Identity.Name</span>
                </div>
                <nav class="sidebar-nav" aria-label="Main navigation">
                    <a class="sidebar-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                    {
                        <a class="sidebar-link" asp-controller="Employee" asp-action="Index">Employees</a>
                        <a class="sidebar-link" asp-controller="Department" asp-action="Index">Departments</a>
                        <a class="sidebar-link" asp-controller="Designation" asp-action="Index">Designations</a>
                        <a class="sidebar-link" asp-controller="Account" asp-action="Create">Create account</a>
                    }
                    else if (User.IsInRole("Manager"))
                    {
                        <a class="sidebar-link" asp-controller="Employee" asp-action="Index">Team records</a>
                    }
                    else
                    {
                        <a class="sidebar-link" asp-controller="Employee" asp-action="Index">Staff directory</a>
                    }
                    <a class="sidebar-link" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </nav>
                <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout">
                    <button type="submit" class="btn btn-outline-light w-100">Logout</button>
                </form>
            </aside>
            <main class="app-content">
                <div class="container-fluid p-4">
                    @RenderBody()
                </div>
            </main>
        </div>
    }
    else
    {
        <header class="border-bottom bg-white">
            <nav class="navbar container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">StaffManagement</a>
                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
            </nav>
        </header>
        <main class="container py-4">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
