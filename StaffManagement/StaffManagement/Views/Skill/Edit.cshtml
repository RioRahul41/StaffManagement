@model StaffManagement.Core.DTOs.SkillModel.SkillCreateViewModel
@{
    ViewData["Title"] = "Edit skill";
}

<div class="card border-0 shadow-sm" style="max-width: 620px;">
    <div class="card-body p-4">
        <h1 class="h3 mb-1">Edit skill</h1>
        <p class="text-muted mb-4">Update the skill name or its availability for employee profiles.</p>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-12">
                <label asp-for="SkillName" class="form-label"></label>
                <input asp-for="SkillName" class="form-control" autofocus />
                <span asp-validation-for="SkillName" class="text-danger"></span>
            </div>
            <div class="col-12 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Available for employees to select</label>
            </div>
            <div class="col-12 d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
