@model StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto
@{ ViewData["Title"] = "Employee details"; }
<div class="mb-4">
    <h1 class="mb-1">Employee details</h1>
    <p class="text-muted mb-0">@Model.FirstName @Model.LastName</p>
</div>
<div class="row g-4">
    <aside class="col-md-3 col-lg-2">
        <nav class="nav nav-pills flex-column" aria-label="Employee information">
            <a class="nav-link active" href="#employee-details">Employee details</a>
            @if (ViewBag.HasProfileInformation is true)
            {
                <a class="nav-link" asp-controller="EmployeeProfile" asp-action="Details" asp-route-employeeId="@Model.Id">Profile information</a>
            }
            else if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Manager"))
            {
                <a class="nav-link" asp-controller="EmployeeProfile" asp-action="Create" asp-route-employeeId="@Model.Id">Add profile information</a>
            }
            else
            {
                <span class="nav-link disabled">Profile information not added</span>
            }
        </nav>
    </aside>
    <main class="col-md-9 col-lg-10">
        <section id="employee-details" class="card">
            <div class="card-body">
                <h2 class="h4 mb-4">Employee details</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">First name</dt><dd class="col-sm-8">@Model.FirstName</dd>
                    <dt class="col-sm-4">Last name</dt><dd class="col-sm-8">@Model.LastName</dd>
                    <dt class="col-sm-4">Office email</dt><dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Personal email</dt><dd class="col-sm-8">@(Model.PersonalEmail ?? "Not provided")</dd>
                    <dt class="col-sm-4">Department</dt><dd class="col-sm-8">@(Model.Department ?? "Not assigned")</dd>
                    <dt class="col-sm-4">Designation</dt><dd class="col-sm-8">@(Model.Designation ?? "Not assigned")</dd>
                    <dt class="col-sm-4">Reporting person</dt><dd class="col-sm-8">@(Model.ReportingPersonName ?? "Not assigned")</dd>
                    <dt class="col-sm-4">Skills</dt><dd class="col-sm-8">@(Model.Skills ?? "Not provided")</dd>
                    <dt class="col-sm-4">Location</dt><dd class="col-sm-8">@Model.Location</dd>
                    <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.EmpIsActive ? "Active" : "Inactive")</dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoPath))
                {
                    <img src="@Url.Action("ProfilePhoto", "Employee", new { id = Model.Id })" alt="Profile photo" class="rounded-circle mt-3" style="width: 96px; height: 96px; object-fit: cover;" />
                }
            </div>
        </section>
        <a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
    </main>
</div>
