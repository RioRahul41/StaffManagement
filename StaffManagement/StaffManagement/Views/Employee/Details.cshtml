@model StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto
@{ ViewData["Title"] = "Employee details"; }
<h1>Employee details</h1><dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.FirstName @Model.LastName</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.Department</dd><dt class="col-sm-3">Designation</dt><dd class="col-sm-9">@Model.Designation</dd><dt class="col-sm-3">Location</dt><dd class="col-sm-9">@Model.Location</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.EmpIsActive ? "Active" : "Inactive")</dd></dl><a asp-action="Index" class="btn btn-secondary">Back</a>
