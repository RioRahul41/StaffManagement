@model StaffManagement.Core.DTOs.EmployeeModel.DeleteEmployeeDto

@{
    ViewData["Title"] = "Delete employee";
}

<h1 class="mb-3">Delete employee</h1>

<div class="alert alert-warning">
    <strong>Warning!</strong>
    This action will deactivate the employee and hide the record from the active employee list.
    The employee record will be retained for historical purposes.
</div>

<div class="card">
    <div class="card-body">

        <h5 class="mb-3">Employee information</h5>

        <p><strong>Name:</strong> @ViewBag.EmployeeName</p>
        <p><strong>Email:</strong> @ViewBag.EmployeeEmail</p>

        <hr />

        <form asp-action="Delete" method="post" id="deleteEmployeeForm">

            @Html.AntiForgeryToken()

            <input asp-for="EmployeeId" type="hidden" />

            <div class="mb-3">
                <label asp-for="RelievingTypeId" class="form-label">
                    Relieving Type <span class="text-danger">*</span>
                </label>

                <select asp-for="RelievingTypeId"
                        asp-items="ViewBag.RelievingTypes"
                        class="form-select">
                    <option value="">-- Select Relieving Type --</option>
                </select>

                <span asp-validation-for="RelievingTypeId"
                      class="text-danger"></span>
            </div>

            <input asp-for="DeletedReason" type="hidden" id="DeletedReason" />

            <span asp-validation-for="DeletedReason"
                  class="text-danger"></span>

            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-danger"
                        id="confirmDeleteBtn">
                    Delete Employee
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.getElementById("confirmDeleteBtn").addEventListener("click", function () {

            const form = document.getElementById("deleteEmployeeForm");
            const relievingType = document.getElementById("RelievingTypeId");

            if (!relievingType.value) {
                Swal.fire({
                    icon: "warning",
                    title: "Relieving Type Required",
                    text: "Please select a relieving type."
                });
                return;
            }

            Swal.fire({
                title: "Are you sure?",
                text: "Do you want to delete this employee?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, continue",
                cancelButtonText: "No, cancel",
                confirmButtonColor: "#d33",
                cancelButtonColor: "#6c757d"
            }).then((result) => {

                if (result.isConfirmed) {

                    Swal.fire({
                        title: "Reason for deletion",
                        input: "textarea",
                        inputPlaceholder: "Enter the reason for deleting this employee...",
                        inputAttributes: {
                            maxlength: 500
                        },
                        showCancelButton: true,
                        confirmButtonText: "Confirm Delete",
                        cancelButtonText: "Cancel",
                        confirmButtonColor: "#d33",
                        inputValidator: (value) => {
                            if (!value || !value.trim()) {
                                return "Please enter the reason for deletion.";
                            }
                        }
                    }).then((reasonResult) => {

                        if (reasonResult.isConfirmed) {
                            document.getElementById("DeletedReason").value =
                                reasonResult.value.trim();

                            form.submit();
                        }

                    });
                }
            });
        });
    </script>
}
