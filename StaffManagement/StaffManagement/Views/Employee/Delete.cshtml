@model StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto
@{ ViewData["Title"] = "Delete employee"; }
<h1>Delete employee</h1><div class="alert alert-warning">This will deactivate the employee and hide the record from the active employee list.</div><p>Delete <strong>@Model.FirstName @Model.LastName</strong> (@Model.Email)?</p><form asp-action="Delete" method="post"><input asp-for="Id" type="hidden" /><button class="btn btn-danger" type="submit">Delete</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
