@model StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto
@{
    ViewData["Title"] = "Edit employee";
    var managers = ViewBag.Managers as IReadOnlyList<StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto> ?? [];
    var canAssignReportingPerson = User.IsInRole("Admin") || User.IsInRole("HR");
    var reportingPersonRoles = ViewBag.ReportingPersonRoles as IReadOnlyDictionary<int, string> ?? new Dictionary<int, string>();
    var targetEmployeeRole = ViewBag.TargetEmployeeRole as string ?? "";
    var allowedReportingPersonRoles = StaffManagement.Core.Security.RoleNames.ReportingRolesFor(targetEmployeeRole);
}
<h1>Edit employee</h1>
<form asp-action="Edit" method="post" class="row g-3">
    <input asp-for="Id" type="hidden" />
    <input asp-for="IdentityUserId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="10" pattern="[0-9]{10}" data-phone-number placeholder="10-digit number" aria-describedby="Phone-hint" class="form-control" />
        <div id="Phone-hint" class="form-text">Optional. If entered, use exactly 10 digits.</div>
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DepartmentId" class="form-label">Department</label>
        <span class="text-danger" aria-hidden="true">*</span>
        <select asp-for="DepartmentId" class="form-select">
            <option value="">Select department</option>
            @foreach (var department in ViewBag.Departments as IReadOnlyList<StaffManagement.Model.Entities.Department> ?? [])
            {
                <option value="@department.DepartmentId">@department.DepartmentName</option>
            }
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Designation" class="form-label"></label>
        <select asp-for="Designation" class="form-select">
            <option value="">Select designation</option>
            @foreach (var designation in ViewBag.Designations as IReadOnlyList<StaffManagement.Model.Entities.Designation> ?? [])
            {
                <option value="@designation.DesignationName">@designation.DesignationName</option>
            }
        </select>
        <span asp-validation-for="Designation" class="text-danger"></span>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        var projects = ViewBag.Projects as IReadOnlyList<StaffManagement.Model.Entities.Project> ?? [];
        <div class="col-md-6">
            <label asp-for="ProjectIds" class="form-label">Assigned projects</label>
            @if (projects.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No active projects are available. <a asp-controller="Project" asp-action="Create">Create a project</a> first.
                </div>
            }
            else
            {
                <div class="border rounded p-3">
                @foreach (var project in projects)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="ProjectIds" value="@project.ProjectId" id="project-@project.ProjectId" checked="@(Model.ProjectIds.Contains(project.ProjectId) ? "checked" : null)" />
                        <label class="form-check-label" for="project-@project.ProjectId">@project.ProjectName</label>
                    </div>
                }
                </div>
            }
        </div>
    }
    else
    {
        <div class="col-md-6"><label class="form-label">Assigned projects</label><input value="@(Model.AssignedProjects.Count == 0 ? "No projects assigned" : string.Join(", ", Model.AssignedProjects.Select(project => project.ProjectName)))" class="form-control" readonly /></div>
    }
    @if (canAssignReportingPerson)
    {
        @if (targetEmployeeRole == StaffManagement.Core.Security.RoleNames.Admin)
        {
            <div class="col-md-6"><label class="form-label">Reporting person</label><input class="form-control" value="Not applicable to Admin accounts" readonly /></div>
        }
        else if (allowedReportingPersonRoles.Count > 0)
        {
            <div class="col-md-6"><label asp-for="ReportingPersonId" class="form-label">Reporting person</label><span class="text-danger" aria-hidden="true">*</span><select asp-for="ReportingPersonId" class="form-select" data-target-role="@targetEmployeeRole"><option value="">-- Select reporting person --</option>@foreach (var manager in managers) { if (manager.Id != Model.Id) { var managerRole = reportingPersonRoles.TryGetValue(manager.Id, out var assignedRole) ? assignedRole : ""; <option value="@manager.Id" data-reporting-role="@managerRole">@manager.FirstName @manager.LastName (@managerRole) (@manager.Email)</option> } }</select><span asp-validation-for="ReportingPersonId" class="text-danger"></span><div id="reporting-person-help" class="form-text">Allowed roles: @string.Join(" or ", allowedReportingPersonRoles).</div></div>
        }
        else
        {
            <div class="col-md-6"><label class="form-label">Reporting person</label><input class="form-control" value="Not required for this role" readonly /></div>
        }
    }
    else
    {
        <div class="col-md-6"><label class="form-label">Reporting person</label><input class="form-control" value="@(Model.ReportingPersonName ?? "Not assigned")" readonly /></div>
    }
    <div class="col-md-6"><label asp-for="Location" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="DOB" class="form-label"></label><input asp-for="DOB" class="form-control" /></div>
    <div class="col-12 form-check"><input asp-for="EmpIsActive" class="form-check-input" /><label asp-for="EmpIsActive" class="form-check-label"></label></div>
    <div class="col-12"><button class="btn btn-primary" type="submit">Save</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const reportingPerson = document.getElementById('@Html.IdFor(model => model.ReportingPersonId)');
        if (reportingPerson) {
            const allowedByRole = { 'HR': ['Admin'], 'Manager': ['Admin'], 'User': ['HR', 'Manager'], 'Technical Support': ['Admin'] };
            const allowed = allowedByRole[reportingPerson.dataset.targetRole] || [];
            Array.from(reportingPerson.options).forEach(option => {
                if (!option.value) return;
                const visible = allowed.includes(option.dataset.reportingRole);
                option.hidden = !visible;
                option.disabled = !visible;
                if (!visible && option.selected) reportingPerson.value = '';
            });
            reportingPerson.required = ['HR', 'Manager', 'User', 'Technical Support'].includes(reportingPerson.dataset.targetRole);
        }
    </script>
}
