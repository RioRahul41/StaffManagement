@model StaffManagement.Models.EmployeeListViewModel
@{
    ViewData["Title"] = "Employees";
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Manager");
    var canDelete = User.IsInRole("Admin");
    var canCreate = User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Manager");
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.5/css/dataTables.dataTables.min.css" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">STAFF DIRECTORY</p>
        <h1 class="mb-1">Employees</h1>
        <p class="text-muted mb-0">View and maintain employee records.</p>
    </div>
    @if (canCreate)
    {
        <a asp-action="Create" class="btn btn-primary">Create employee account</a>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-3 align-items-end mb-3" aria-label="Employee filters">
            <div class="col-sm-6 col-lg-4">
                <label class="form-label" for="departmentFilter">Department</label>
                <select id="departmentFilter" class="form-select">
                    <option value="">All departments</option>
                    @foreach (var department in Model.Departments)
                    {
                        <option value="@department.DepartmentId">@department.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="designationFilter">Designation</label>
                <select id="designationFilter" class="form-select">
                    <option value="">All designations</option>
                    @foreach (var designation in Model.Designations)
                    {
                        <option value="@designation.DesignationName">@designation.DesignationName</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="statusFilter">Status</label>
                <select id="statusFilter" class="form-select">
                    <option value="">All statuses</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <div class="col-sm-6 col-lg-2">
                <button type="button" id="resetEmployeeFilters" class="btn btn-outline-secondary w-100">Reset</button>
            </div>
        </div>

        <div class="table-responsive">
            <table id="employeeTable" class="table table-hover align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th class="text-center">S.No.</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Assigned projects</th>
                        <th>Reporting person</th>
                        <th>Account</th>
                        <th>Status</th>
                        <th>Project assignment</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalCount == 0)
{
    <div class="card border-0 shadow-sm"><div class="card-body text-center py-5"><h4>No employees found</h4><p class="text-muted">Try changing or clearing your search and filters.</p>@if (canCreate) { <a asp-action="Create" class="btn btn-primary">Create employee account</a> }</div></div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted">Showing @(((Model.PageNumber - 1) * Model.PageSize) + 1)–@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of @Model.TotalCount employees</span>
        <span class="text-muted">Page @Model.PageNumber of @Model.TotalPages</span>
    </div>
    <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th class="text-center">S.No.</th><th>Name</th><th>Email</th><th>Department</th><th>Assigned projects</th><th>Reporting-Person</th><th>Account</th><th>Status</th><th>Project assignment</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var employee in Model.Employees.Select((item, index) => new { Item = item, Index = (Model.PageNumber - 1) * Model.PageSize + index + 1 }))
        {
            <tr>
                <td class="text-center">@employee.Index</td>
                <td><strong>@employee.Item.FirstName @employee.Item.LastName</strong><br /><small class="text-muted">@employee.Item.Designation</small></td>
                <td>@employee.Item.Email</td>
                <td>@(employee.Item.Department ?? "-")</td>
                <td>@(employee.Item.AssignedProjects.Count == 0 ? "None" : string.Join(", ", employee.Item.AssignedProjects.Select(project => project.ProjectName)))</td>
                <td>@(employee.Item.ReportingPersonName ?? "-")</td>
                <td>@if (employee.Item.IdentityUserId is null) { <span class="badge text-bg-warning">Not linked</span> } else { <span class="badge text-bg-success">Linked</span> }</td>
                <td>@if (employee.Item.EmpIsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Inactive</span> }</td>
                <td class="text-nowrap">
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a asp-action="AssignProjects" asp-route-id="@employee.Item.Id" class="btn btn-sm btn-outline-success">Assign projects</a>
                    }
                },
                {
                    data: 'isActive',
                    name: 'status',
                    render: function (active, type) {
                        const text = active ? 'Active' : 'Inactive';
                        if (type !== 'display') return text;
                        const badge = document.createElement('span');
                        badge.className = 'badge ' + (active ? 'text-bg-success' : 'text-bg-secondary');
                        badge.textContent = text;
                        return badge.outerHTML;
                    }
                },
                {
                    data: null,
                    name: 'projectAssignment',
                    searchable: false,
                    orderable: false,
                    render: function (_data, type, row) {
                        if (type !== 'display') return '';
                        if (!row.canAssignProjects) return '<span class="text-muted">-</span>';
                        const link = document.createElement('a');
                        link.className = 'btn btn-sm btn-outline-success text-nowrap';
                        link.href = row.assignProjectsUrl;
                        link.textContent = 'Assign projects';
                        return link.outerHTML;
                    }
                },
                {
                    data: null,
                    name: 'actions',
                    searchable: false,
                    orderable: false,
                    className: 'text-end text-nowrap',
                    render: function (_data, type, row) {
                        if (type !== 'display') return '';
                        const wrapper = document.createElement('div');
                        wrapper.className = 'dropdown';
                        const trigger = document.createElement('button');
                        trigger.type = 'button';
                        trigger.className = 'btn btn-sm btn-outline-secondary';
                        trigger.setAttribute('data-bs-toggle', 'dropdown');
                        trigger.setAttribute('aria-expanded', 'false');
                        trigger.setAttribute('aria-label', 'Actions for ' + row.firstName + ' ' + row.lastName);
                        trigger.title = 'Actions';
                        trigger.innerHTML = '<span aria-hidden="true">&#8942;</span>';
                        const menu = document.createElement('ul');
                        menu.className = 'dropdown-menu dropdown-menu-end';
                        const addLink = (label, url, danger) => {
                            const item = document.createElement('li');
                            const link = document.createElement('a');
                            link.className = 'dropdown-item' + (danger ? ' text-danger' : '');
                            link.href = url;
                            link.textContent = label;
                            item.appendChild(link);
                            menu.appendChild(item);
                        };
                        addLink('View', row.viewUrl, false);
                        if (row.canEdit) addLink('Edit', row.editUrl, false);
                        if (row.canDelete) addLink('Delete', row.deleteUrl, true);
                        wrapper.append(trigger, menu);
                        return wrapper.outerHTML;
                    }
                }
            ],
            language: {
                emptyTable: 'No employees found.',
                processing: 'Loading employees…',
                search: 'Search employees:'
            }
        });

        document.querySelectorAll('#departmentFilter, #designationFilter, #statusFilter').forEach(filter => {
            filter.addEventListener('change', () => employeeTable.ajax.reload(null, true));
        });

        document.getElementById('resetEmployeeFilters').addEventListener('click', () => {
            document.getElementById('departmentFilter').value = '';
            document.getElementById('designationFilter').value = '';
            document.getElementById('statusFilter').value = '';
            employeeTable.search('').order([[1, 'asc']]).page('first').draw();
        });
    </script>
    @if (TempData["Success"] is string success)
    {
        <script>Swal.fire({ icon: 'success', title: 'Saved', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(success)), timer: 2200, showConfirmButton: false });</script>
    }
    @if (TempData["Error"] is string error)
    {
        <script>Swal.fire({ icon: 'error', title: 'Unable to complete action', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(error)) });</script>
    }
}
