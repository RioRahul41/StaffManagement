@model IReadOnlyList<StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto>
@{
    ViewData["Title"] = "Employees";
    var canManage = User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Manager");
    var canCreate = User.IsInRole("Admin") || User.IsInRole("HR");
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">STAFF DIRECTORY</p>
        <h1 class="mb-1">Employees</h1>
        <p class="text-muted mb-0">View and maintain employee records.</p>
    </div>
    @if (canCreate)
    {
        <a asp-action="Create" class="btn btn-primary">Create employee account</a>
    }
</div>
@if (TempData["Success"] is string success)
{
    <script>window.employeeSuccessMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(success));</script>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        if (window.employeeSuccessMessage) {
            Swal.fire({ icon: 'success', title: 'Saved', text: window.employeeSuccessMessage, timer: 2200, showConfirmButton: false });
        }
    </script>
}
@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm"><div class="card-body text-center py-5"><h4>No employees found</h4><p class="text-muted">Create the first employee account to populate the directory.</p>@if (canCreate) { <a asp-action="Create" class="btn btn-primary">Create employee account</a> }</div></div>
}
else
{
    <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Name</th><th>Email</th><th>Department</th><th>Assigned projects</th><th>Account</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td><strong>@employee.FirstName @employee.LastName</strong><br /><small class="text-muted">@employee.Designation</small></td>
                <td>@employee.Email</td>
                <td>@(employee.Department ?? "-")</td>
                <td>@(employee.AssignedProjects.Count == 0 ? "None" : string.Join(", ", employee.AssignedProjects.Select(project => project.ProjectName)))</td>
                <td>@if (employee.IdentityUserId is null) { <span class="badge text-bg-warning">Not linked</span> } else { <span class="badge text-bg-success">Linked</span> }</td>
                <td>@if (employee.EmpIsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Inactive</span> }</td>
                <td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-secondary">Details</a>@if (canManage) { <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary ms-1">Edit</a><a asp-action="Delete" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-danger ms-1">Delete</a> }@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a asp-action="AssignProjects" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-success ms-1">Assign projects</a> }</td>
            </tr>
        }
        </tbody>
    </table></div></div>
}
