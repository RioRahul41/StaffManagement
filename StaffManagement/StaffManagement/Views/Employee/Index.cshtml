@model StaffManagement.Models.EmployeeListViewModel
@{
    ViewData["Title"] = "Employees";
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Manager");
    var canDelete = User.IsInRole("Admin");
    var canCreate = User.IsInRole("Admin") || User.IsInRole("HR");
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">STAFF DIRECTORY</p>
        <h1 class="mb-1">Employees</h1>
        <p class="text-muted mb-0">View and maintain employee records.</p>
    </div>
    @if (canCreate)
    {
        <a asp-action="Create" class="btn btn-primary">Create employee account</a>
    }
</div>
@if (TempData["Success"] is string success)
{
    <script>window.employeeSuccessMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(success));</script>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        if (window.employeeSuccessMessage) {
            Swal.fire({ icon: 'success', title: 'Saved', text: window.employeeSuccessMessage, timer: 2200, showConfirmButton: false });
        }
    </script>
}
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-12 col-lg-4">
                <label for="searchTerm" class="form-label">Search employees</label>
                <input id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Name, email, location..." />
            </div>
            <div class="col-6 col-lg-2">
                <label for="departmentId" class="form-label">Department</label>
                <select id="departmentId" name="departmentId" class="form-select">
                    <option value="">All departments</option>
                    @foreach (var department in Model.Departments)
                    {
                        <option value="@department.DepartmentId" selected="@(Model.DepartmentId == department.DepartmentId ? "selected" : null)">@department.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label for="designation" class="form-label">Designation</label>
                <select id="designation" name="designation" class="form-select">
                    <option value="">All designations</option>
                    @foreach (var designation in Model.Designations)
                    {
                        <option value="@designation.DesignationName" selected="@(Model.Designation == designation.DesignationName ? "selected" : null)">@designation.DesignationName</option>
                    }
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label for="isActive" class="form-label">Status</label>
                <select id="isActive" name="isActive" class="form-select">
                    <option value="">All statuses</option>
                    <option value="true" selected="@(Model.IsActive == true ? "selected" : null)">Active</option>
                    <option value="false" selected="@(Model.IsActive == false ? "selected" : null)">Inactive</option>
                </select>
            </div>
            <div class="col-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (Model.TotalCount == 0)
{
    <div class="card border-0 shadow-sm"><div class="card-body text-center py-5"><h4>No employees found</h4><p class="text-muted">Try changing or clearing your search and filters.</p>@if (canCreate) { <a asp-action="Create" class="btn btn-primary">Create employee account</a> }</div></div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted">Showing @(((Model.PageNumber - 1) * Model.PageSize) + 1)–@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of @Model.TotalCount employees</span>
        <span class="text-muted">Page @Model.PageNumber of @Model.TotalPages</span>
    </div>
    <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Name</th><th>Email</th><th>Department</th><th>Assigned projects</th><th>Reporting-Person</th> <th>Account</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var employee in Model.Employees)
        {
            <tr>
                <td><strong>@employee.FirstName @employee.LastName</strong><br /><small class="text-muted">@employee.Designation</small></td>
                <td>@employee.Email</td>
                <td>@(employee.Department ?? "-")</td>
                <td>@(employee.AssignedProjects.Count == 0 ? "None" : string.Join(", ", employee.AssignedProjects.Select(project => project.ProjectName)))</td>
                <td>@(employee.ReportingPersonName ?? "-")</td>
                <td>@if (employee.IdentityUserId is null) { <span class="badge text-bg-warning">Not linked</span> } else { <span class="badge text-bg-success">Linked</span> }</td>
                <td>@if (employee.EmpIsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Inactive</span> }</td>
                <td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-secondary">Details</a>@if (canEdit) { <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary ms-1">Edit</a> }@if (canDelete) { <a asp-action="Delete" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-danger ms-1">Delete</a> }@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a asp-action="AssignProjects" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-success ms-1">Assign projects</a> }</td>
            </tr>
        }
        </tbody>
    </table></div></div>
    @if (Model.TotalPages > 1)
    {
        var startPage = Math.Max(1, Model.PageNumber - 2);
        var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
        <nav class="mt-3" aria-label="Employee list pages">
            <ul class="pagination justify-content-end">
                <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-departmentId="@Model.DepartmentId" asp-route-designation="@Model.Designation" asp-route-isActive="@Model.IsActive" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                </li>
                @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-departmentId="@Model.DepartmentId" asp-route-designation="@Model.Designation" asp-route-isActive="@Model.IsActive" asp-route-page="@pageNumber">@pageNumber</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-departmentId="@Model.DepartmentId" asp-route-designation="@Model.Designation" asp-route-isActive="@Model.IsActive" asp-route-page="@(Model.PageNumber + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
}
