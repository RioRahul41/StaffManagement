@model StaffManagement.Core.DTOs.EmployeeModel.EmployeeDto
@{
    ViewData["Title"] = "Assign projects";
    var projects = ViewBag.Projects as IReadOnlyList<StaffManagement.Model.Entities.Project> ?? [];
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">&larr; Back</a>
    <div>
        <h1 class="mb-1">Assign projects</h1>
        <p class="text-muted mb-0">Choose projects for @Model.FirstName @Model.LastName.</p>
    </div>
</div>

<div class="card border-0 shadow-sm"><div class="card-body p-4">
    @if (projects.Count == 0)
    {
        <div class="alert alert-info">There are no active projects to assign. <a asp-controller="Project" asp-action="Create">Create a project</a> first.</div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to employees</a>
    }
    else
    {
        <form asp-action="AssignProjects" asp-route-id="@Model.Id" method="post" id="assign-projects-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <p class="text-muted">Select one or more active projects. The employee will see these in the timesheet project list.</p>
            <div class="border rounded p-3 mb-4">
                @foreach (var project in projects)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="projectIds" value="@project.ProjectId" id="project-@project.ProjectId" checked="@(Model.ProjectIds.Contains(project.ProjectId) ? "checked" : null)" />
                        <label class="form-check-label" for="project-@project.ProjectId">@project.ProjectName</label>
                    </div>
                }
            </div>
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save assignments</button>
            </div>
        </form>
    }
</div></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const form = document.getElementById('assign-projects-form');
        if (form) {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                Swal.fire({
                    title: 'Save project assignments?',
                    text: 'The selected projects will be available in this employee’s timesheets.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Save assignments',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) form.submit();
                });
            });
        }
    </script>
}
