@model StaffManagement.Model.Entities.Designation

@{ ViewData["Title"] = "Designation Details"; }

<h1>Designation Details</h1>
<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.DesignationName</dd>
    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>
    <dt class="col-sm-3">Created date</dt>
    <dd class="col-sm-9">@Model.CreatedDate</dd>
    <dt class="col-sm-3">Updated date</dt>
    <dd class="col-sm-9">@(Model.UpdatedDate?.ToString() ?? "Not updated")</dd>
    <dt class="col-sm-3">Active</dt>
    <dd class="col-sm-9">@Model.IsActive</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.DesignationId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
