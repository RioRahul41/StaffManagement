@model StaffManagement.Model.Entities.Designation

@{ ViewData["Title"] = "Create Designation"; }

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">&larr; Back</a>
            <div>
                <h1 class="mb-1">Create Designation</h1>
                <p class="text-muted mb-0">Add a new designation to your organization.</p>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <partial name="_DesignationForm" model="Model" />
                    <hr class="my-4" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Create Designation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
