@model IReadOnlyList<StaffManagement.Model.Entities.Designation>

@{ ViewData["Title"] = "Designations"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Designations</h1>
        <p class="text-muted mb-0">Manage your organization's designations.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Designation
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <h5>No designations found</h5>
                <p class="text-muted">Create the first designation to get started.</p>
                <a asp-action="Create" class="btn btn-primary">Create Designation</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Designation Name</th>
                            <th>Description</th>
                            <th>Created Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var designation in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@designation.DesignationName</td>
                            <td>@(string.IsNullOrWhiteSpace(designation.Description) ? "—" : designation.Description)</td>
                            <td>@designation.CreatedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge @(designation.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(designation.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Detail" asp-route-id="@designation.DesignationId" class="btn btn-sm btn-outline-info me-1">Details</a>
                                <a asp-action="Edit" asp-route-id="@designation.DesignationId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                <form asp-action="Delete" asp-route-id="@designation.DesignationId" method="post" class="d-inline delete-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["SuccessMessage"] is string)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '@TempData["SuccessMessage"]',
                timer: 2200,
                showConfirmButton: false
            });
        </script>
    }
    <script>
        document.querySelectorAll('.delete-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                Swal.fire({
                    title: 'Delete this designation?',
                    text: 'The designation will be deactivated.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}
