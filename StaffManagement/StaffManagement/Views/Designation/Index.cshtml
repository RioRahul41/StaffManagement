@model IReadOnlyList<StaffManagement.Core.DTOs.DesignationModel.DesignationDto>

@{
    ViewData["Title"] = "Designations";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.css" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Designations</h1>
        <p class="text-muted mb-0">Manage your organization's designations.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Designation
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <h5>No designations found</h5>
                <p class="text-muted">Create the first designation to get started.</p>
                <a asp-action="Create" class="btn btn-primary">Create Designation</a>
            </div>
        }
        else
        {
            <div class="row g-3 mb-3 align-items-end">
                <div class="col-md-4">
                    <label for="designationNameFilter" class="form-label">Designation</label>
                    <select id="designationNameFilter" class="form-select">
                        <option value="">All designations</option>
                        @foreach (var name in Model.Select(designation => designation.DesignationName).Where(name => !string.IsNullOrWhiteSpace(name)).Distinct().OrderBy(name => name))
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="designationStatusFilter" class="form-label">Status</label>
                    <select id="designationStatusFilter" class="form-select">
                        <option value="">All statuses</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="button" id="designationResetSearch" class="btn btn-outline-secondary">Reset search</button>
                </div>
            </div>
            <div class="table-responsive">
                <table id="designationTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">S.No.</th>
                            <th>Designation Name</th>
                            <th>Department</th>
                            <th>Description</th>
                            <th>Created Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var designation in Model.Select((item, index) => new { Item = item, Index = index + 1 }))
                        {
                            <tr>
                                <td class="text-center"></td>
                                <td class="fw-semibold">@designation.Item.DesignationName</td>
                                <td>@(designation.Item.DepartmentName ?? "Not assigned")</td>
                                <td>@(string.IsNullOrWhiteSpace(designation.Item.Description) ? "—" : designation.Item.Description)</td>
                                <td>@designation.Item.CreatedDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge @(designation.Item.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                        @(designation.Item.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Designation actions">
                                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false" style="display:block"><circle cx="8" cy="3" r="1.3" /><circle cx="8" cy="8" r="1.3" /><circle cx="8" cy="13" r="1.3" /></svg>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a asp-action="Detail" asp-route-id="@designation.Item.DesignationId" class="dropdown-item">Details</a></li>
                                            <li><a asp-action="Edit" asp-route-id="@designation.Item.DesignationId" class="dropdown-item">Edit</a></li>
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@designation.Item.DesignationId" method="post" class="delete-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-danger">Delete</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
            function initDesignationPage() {
                const tableElement = document.querySelector('#designationTable');
                if (tableElement) {
                    const table = DataTable.isDataTable(tableElement)
                        ? new DataTable(tableElement)
                        : new DataTable(tableElement, {
                            pageLength: 10,
                            columnDefs: [
                                { targets: [0, 6], orderable: false, searchable: false }
                            ],
                            drawCallback: function () {
                                const info = this.api().page.info();
                                this.api().column(0, { page: 'current', order: 'applied', search: 'applied' }).nodes().each(function (cell, index) {
                                    cell.textContent = info.start + index + 1;
                                });
                            }
                        });

                    const nameFilter = document.getElementById('designationNameFilter');
                    const statusFilter = document.getElementById('designationStatusFilter');
                    const resetButton = document.getElementById('designationResetSearch');

                    if (nameFilter) {
                        nameFilter.addEventListener('change', function () {
                            const val = this.value;
                            table.column(1).search(val ? '^' + DataTable.util.escapeRegex(val) + '$' : '', true, false).draw();
                        });
                    }

                    if (statusFilter) {
                        statusFilter.addEventListener('change', function () {
                            const val = this.value;
                            table.column(5).search(val ? '^\\s*' + DataTable.util.escapeRegex(val) + '\\s*$' : '', true, false).draw();
                        });
                    }

                    if (resetButton) {
                        resetButton.addEventListener('click', function () {
                            if (nameFilter) nameFilter.value = '';
                            if (statusFilter) statusFilter.value = '';

                            // Clear global search and reset flags
                            table.search('', false, true);

                            // Clear every column search and reset flags
                            table.columns().every(function () {
                                this.search('', false, true);
                            });

                            // Clear the visible search input
                            const searchInput = document.querySelector('#designationTable_wrapper .dt-search input');
                            if (searchInput) {
                                searchInput.value = '';
                            }

                            // Return to first page and redraw full dataset
                            table.page('first').draw();
                        });
                    }
                }

                document.querySelectorAll('.delete-form').forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        event.preventDefault();
                        Swal.fire({
                            title: 'Delete this designation?',
                            text: 'The designation will be deactivated.',
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#dc3545',
                            cancelButtonColor: '#6c757d',
                            confirmButtonText: 'Yes, delete it',
                            cancelButtonText: 'Cancel'
                        }).then(function (result) {
                            if (result.isConfirmed) {
                                form.submit();
                            }
                        });
                    });
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initDesignationPage);
            } else {
                initDesignationPage();
            }
        })();
    </script>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: @Json.Serialize(successMessage),
                timer: 2200,
                showConfirmButton: false
            });
        </script>
    }
}
