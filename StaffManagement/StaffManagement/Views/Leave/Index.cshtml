@using StaffManagement.Core.DTOs
@using StaffManagement.Model.Enums
@using StaffManagement.Model.Entities
@model PagedResultDto<StaffManagement.Core.DTOs.LeaveModel.LeaveRequestDto>
@{
    ViewData["Title"] = "Leave management";
    var canManageAllowances = User.IsInRole("Admin") || User.IsInRole("HR");
    var leaveBalances = ViewBag.LeaveBalances as IReadOnlyList<StaffManagement.Core.DTOs.LeaveModel.LeaveBalanceDto> ?? [];
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">LEAVE MANAGEMENT</p>
        <h1 class="mb-1">Leave requests</h1>
        <p class="text-muted mb-0">Review your leave history and requests assigned to you.</p>
    </div>
    @if (ViewBag.LeaveBalance is not null) { <a asp-action="Create" class="btn btn-primary">Apply for leave</a> }
</div>
@if (ViewBag.LeaveBalance is StaffManagement.Core.DTOs.LeaveModel.LeaveBalanceDto balance)
{
    <div class="row g-3 mb-3">
        <div class="col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6">Sick leave</h2><div class="d-flex justify-content-between"><span>Available</span><strong>@balance.SickAvailable days</strong></div><small class="text-muted">@balance.SickUsed used · @balance.SickPending pending · @balance.SickAllowance total</small></div></div></div>
        <div class="col-md-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6">Casual leave</h2><div class="d-flex justify-content-between"><span>Available</span><strong>@balance.CasualAvailable days</strong></div><small class="text-muted">@balance.CasualUsed used · @balance.CasualPending pending · @balance.CasualAllowance total</small></div></div></div>
    </div>
}
@if (canManageAllowances)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white"><h2 class="h5 mb-0">Employee leave allowances</h2><small class="text-muted">Update annual limits and review usage and pending requests.</small></div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Employee</th><th>Sick allowance</th><th>Sick used / pending / available</th><th>Casual allowance</th><th>Casual used / pending / available</th><th></th></tr></thead>
            <tbody>
            @foreach (var balanceItem in leaveBalances)
            {
                <tr>
                    <td><strong>@balanceItem.EmployeeName</strong><div class="small text-muted">@balanceItem.Email</div></td>
                        <td><label class="visually-hidden" for="sick-@balanceItem.EmployeeId">Sick leave allowance</label><input form="allowances-@balanceItem.EmployeeId" id="sick-@balanceItem.EmployeeId" name="sickLeaveAllowance" type="number" min="0" max="365" value="@balanceItem.SickAllowance" class="form-control form-control-sm" /></td>
                        <td>@balanceItem.SickUsed used · @balanceItem.SickPending pending · @balanceItem.SickAvailable available</td>
                        <td><label class="visually-hidden" for="casual-@balanceItem.EmployeeId">Casual leave allowance</label><input form="allowances-@balanceItem.EmployeeId" id="casual-@balanceItem.EmployeeId" name="casualLeaveAllowance" type="number" min="0" max="365" value="@balanceItem.CasualAllowance" class="form-control form-control-sm" /></td>
                        <td>@balanceItem.CasualUsed used · @balanceItem.CasualPending pending · @balanceItem.CasualAvailable available</td>
                        <td><form id="allowances-@balanceItem.EmployeeId" asp-action="UpdateAllowances" method="post"><input type="hidden" name="employeeId" value="@balanceItem.EmployeeId" /><button type="submit" class="btn btn-sm btn-outline-primary">Save</button></form></td>
                </tr>
            }
            @if (leaveBalances.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-3">No employees found.</td></tr> }
            </tbody>
        </table></div>
    </div>
}
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
        <span class="text-muted">Total leave applications</span>
        <strong class="fs-4">@Model.TotalCount</strong>
    </div>
</div>
@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
}
<form asp-action="Index" method="get" class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label for="search" class="form-label">Search</label>
                <input id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Employee name or reason" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label for="status" class="form-label">Status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var value in Enum.GetValues<LeaveStatus>())
                    {
                        <option value="@value" selected="@(ViewBag.Status?.ToString() == value.ToString())">@value</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label for="leaveType" class="form-label">Leave type</label>
                <select id="leaveType" name="leaveType" class="form-select">
                    <option value="">All types</option>
                    @foreach (var value in (ViewBag.LeaveTypes as IReadOnlyList<LeaveTypeMaster> ?? []))
                    {
                        <option value="@value.Name" selected="@(ViewBag.LeaveType?.ToString() == value.Name)">@value.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label for="fromDate" class="form-label">From date</label>
                <input id="fromDate" name="fromDate" type="date" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label for="toDate" class="form-label">To date</label>
                <input id="toDate" name="toDate" type="date" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Search / Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </div>
    </div>
</form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th class="text-center">S.No.</th><th>Employee</th><th>Type</th><th>From</th><th>To</th><th>Applied count</th><th>Reason</th><th>Document</th><th>Status</th><th class="text-end">Action</th></tr></thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="10" class="text-center text-muted py-4">No leave requests found.</td></tr>
        }
        else
        {
            @foreach (var request in Model.Items.Select((item, index) => new { Item = item, Index = (Model.PageNumber - 1) * Model.PageSize + index + 1 }))
            {
                <tr>
                    <td class="text-center">@request.Index</td>
                    <td>@request.Item.EmployeeName</td>
                    <td>@request.Item.LeaveType</td>
                    <td>@request.Item.FromDate.ToString("yyyy-MM-dd")</td>
                    <td>@request.Item.ToDate.ToString("yyyy-MM-dd")</td>
                    <td>@request.Item.AppliedDays @(request.Item.AppliedDays == 1 ? "day" : "days")</td>
                    <td>@request.Item.Reason</td>
                    <td>@if (!string.IsNullOrWhiteSpace(request.Item.DocumentPath)) { <a asp-action="Document" asp-route-id="@request.Item.Id">Download</a> } else { <span class="text-muted">-</span> }</td>
                    <td><span class="badge @(request.Item.Status == LeaveStatus.Approved ? "text-bg-success" : request.Item.Status == LeaveStatus.Rejected ? "text-bg-danger" : "text-bg-warning")">@request.Item.Status</span></td>
                    <td class="text-end text-nowrap">
                        @if (request.Item.CanReview)
                        {
                            <form asp-action="Approve" asp-route-id="@request.Item.Id" method="post" class="d-inline leave-review-form" data-confirm-title="Approve this leave?" data-confirm-text="This request will be marked as approved.">
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                            <form asp-action="Reject" asp-route-id="@request.Item.Id" method="post" class="d-inline leave-review-form" data-confirm-title="Reject this leave?" data-confirm-text="This request will be marked as rejected.">
                                <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                            </form>
                        }
                        else if (request.Item.CanCancel)
                        {
                            <form asp-action="Cancel" asp-route-id="@request.Item.Id" method="post" class="d-inline leave-review-form" data-confirm-title="Cancel this leave?" data-confirm-text="The pending days will be released back to your available balance.">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">View only</span>
                        }
                    </td>
                </tr>
            }
        }
        </tbody>
</table></div></div>
@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Leave request pages"><ul class="pagination">
        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-leaveType="@ViewBag.LeaveType" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">Previous</a></li>
        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
        {
            <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@pageNumber" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-leaveType="@ViewBag.LeaveType" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">@pageNumber</a></li>
        }
        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status" asp-route-leaveType="@ViewBag.LeaveType" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">Next</a></li>
    </ul></nav>
}
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["Success"] is string success)
    {
        <script>Swal.fire({ icon: 'success', title: 'Success', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(success)), timer: 2200, showConfirmButton: false });</script>
    }
    @if (TempData["Error"] is string error)
    {
        <script>Swal.fire({ icon: 'error', title: 'Unable to complete action', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(error)) });</script>
    }
    <script>
        document.querySelectorAll('.leave-review-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                const currentForm = this;
                Swal.fire({
                    title: currentForm.dataset.confirmTitle,
                    text: currentForm.dataset.confirmText,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: currentForm.action.includes('/Reject') ? '#dc3545' : '#198754',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Confirm',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) currentForm.submit();
                });
            });
        });
    </script>
}
