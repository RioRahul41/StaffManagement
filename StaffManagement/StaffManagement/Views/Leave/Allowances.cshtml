@model IReadOnlyList<StaffManagement.Core.DTOs.LeaveModel.LeaveBalanceDto>
@{
    ViewData["Title"] = "Employee leave allowances";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">LEAVE MANAGEMENT</p>
        <h1 class="mb-1">Employee leave allowances</h1>
        <p class="text-muted mb-0">Update annual sick and casual leave limits and review employee usage.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to leave requests</a>
</div>

<section aria-labelledby="allowances-heading">
    <div class="mb-3">
        <h2 id="allowances-heading" class="h5 mb-1">Annual allowances</h2>
        <p class="text-muted mb-0">
            Set each allowance from 0 to 365 days. Pending requests reserve days; approved requests count as used.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden">Employee sick and casual leave allowances and usage</caption>
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="px-3">Employee</th>
                        <th scope="col">Sick allowance</th>
                        <th scope="col">Sick leave balance</th>
                        <th scope="col">Casual allowance</th>
                        <th scope="col">Casual leave balance</th>
                        <th scope="col" class="text-end px-3"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var balance in Model)
                    {
                        <tr>
                            <th scope="row" class="px-3">
                                <div class="fw-semibold">@balance.EmployeeName</div>
                                <div class="small text-muted">@balance.Email</div>
                            </th>
                            <td>
                                <label class="visually-hidden" for="sick-@balance.EmployeeId">Sick leave allowance in days</label>
                                <div class="input-group input-group-sm" style="min-width: 115px; max-width: 150px;">
                                    <input form="allowances-@balance.EmployeeId" id="sick-@balance.EmployeeId" name="sickLeaveAllowance" type="number" min="0" max="365" value="@balance.SickAllowance" class="form-control" />
                                    <span class="input-group-text">days</span>
                                </div>
                            </td>
                            <td>
                                <div class="small text-nowrap"><span class="fw-semibold">@balance.SickUsed</span> used</div>
                                <div class="small text-muted text-nowrap">@balance.SickPending pending · @balance.SickAvailable available</div>
                            </td>
                            <td>
                                <label class="visually-hidden" for="casual-@balance.EmployeeId">Casual leave allowance in days</label>
                                <div class="input-group input-group-sm" style="min-width: 115px; max-width: 150px;">
                                    <input form="allowances-@balance.EmployeeId" id="casual-@balance.EmployeeId" name="casualLeaveAllowance" type="number" min="0" max="365" value="@balance.CasualAllowance" class="form-control" />
                                    <span class="input-group-text">days</span>
                                </div>
                            </td>
                            <td>
                                <div class="small text-nowrap"><span class="fw-semibold">@balance.CasualUsed</span> used</div>
                                <div class="small text-muted text-nowrap">@balance.CasualPending pending · @balance.CasualAvailable available</div>
                            </td>
                            <td class="text-end px-3">
                                <form id="allowances-@balance.EmployeeId" asp-action="UpdateAllowances" method="post">
                                    <input type="hidden" name="employeeId" value="@balance.EmployeeId" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No employees found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["Success"] is string success)
    {
        <script>Swal.fire({ icon: 'success', title: 'Success', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(success)), timer: 2200, showConfirmButton: false });</script>
    }
    @if (TempData["Error"] is string error)
    {
        <script>Swal.fire({ icon: 'error', title: 'Unable to complete action', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(error)) });</script>
    }
}
