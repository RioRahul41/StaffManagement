@{ ViewData["Title"] = "Technical Support"; }
<div class="mb-4">
    <p class="text-primary fw-semibold mb-1">SUPPORT PORTAL</p>
    <h1 class="mb-1">Technical Support</h1>
    <p class="text-muted mb-0">Review employee Help Desk requests and update their status.</p>
</div>
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h2 class="h5">Help Desk requests</h2>
        <p class="text-muted">View submitted tickets, download attached documents, and keep request status up to date.</p>
        <a asp-controller="HelpDesk" asp-action="Index" class="btn btn-primary">Open Help Desk</a>
    </div>
</div>
