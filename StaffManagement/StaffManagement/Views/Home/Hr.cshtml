@model StaffManagement.Core.DTOs.DashboardViewModel
@{ ViewData["Title"] = "HR Dashboard"; }
<div class="mb-4"><span class="text-primary fw-semibold">PEOPLE OPERATIONS</span><h1 class="display-6 fw-bold">HR Dashboard</h1><p class="text-muted">Welcome, @Model.DisplayName. Keep employee information accurate and up to date.</p></div>
<div class="row g-3 mb-4"><div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><p class="text-muted mb-1">Team members</p><h2>@Model.TotalEmployees</h2></div></div></div><div class="col-md-6"><div class="card border-0 shadow-sm"><div class="card-body"><p class="text-muted mb-1">Active members</p><h2 class="text-success">@Model.ActiveEmployees</h2></div></div></div></div>
<div class="card border-0 shadow-sm"><div class="card-body"><h5>HR actions</h5><p class="text-muted">Create User accounts and maintain employee records.</p><a asp-controller="Account" asp-action="Create" class="btn btn-primary me-2">Create User account</a><a asp-controller="Employee" asp-action="Index" class="btn btn-outline-primary">View employees</a></div></div>
