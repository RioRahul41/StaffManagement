@model StaffManagement.Core.DTOs.DashboardViewModel
@{ ViewData["Title"] = "Admin Dashboard"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><span class="text-primary fw-semibold">ADMIN CONSOLE</span><h1 class="display-6 fw-bold">Welcome, @Model.DisplayName</h1><p class="text-muted">Manage workforce access, roles, and employee records.</p></div><a asp-controller="Account" asp-action="Create" class="btn btn-primary">Create account</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><p class="text-muted mb-1">Total employees</p><h2>@Model.TotalEmployees</h2></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><p class="text-muted mb-1">Active employees</p><h2 class="text-success">@Model.ActiveEmployees</h2></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><p class="text-muted mb-1">Inactive employees</p><h2 class="text-secondary">@Model.InactiveEmployees</h2></div></div></div></div>
<div class="row g-3"><div class="col-md-6"><div class="card h-100"><div class="card-body"><h5>Account administration</h5><p class="text-muted">Create HR, Manager, and User accounts. Only one Admin account is permitted.</p><a asp-controller="Account" asp-action="Create" class="btn btn-outline-primary">Manage accounts</a></div></div></div><div class="col-md-6"><div class="card h-100"><div class="card-body"><h5>Employee records</h5><p class="text-muted">Review, edit, and deactivate employee records.</p><a asp-controller="Employee" asp-action="Index" class="btn btn-outline-primary">Open employees</a></div></div></div></div>
