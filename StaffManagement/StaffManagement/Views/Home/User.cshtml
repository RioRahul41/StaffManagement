@model StaffManagement.Core.DTOs.DashboardViewModel
@{
    ViewData["Title"] = "My workspace";
}

<div class="dashboard-page dashboard-user">
    <section class="dashboard-hero mb-4">
        <div>
            <span class="dashboard-eyebrow">Employee workspace</span>
            <h1>Welcome, @Model.DisplayName</h1>
            <p>See your assigned projects and quickly open your work records, leave, and expense requests.</p>
        </div>
        <a asp-controller="Timesheet" asp-action="Index" class="btn btn-primary">Open timesheets</a>
    </section>

    <h2 class="dashboard-section-title">My work</h2>
    @if (Model.CurrentProjects.Count > 0)
    {
        <div class="dashboard-project-list mb-4">
            <div class="list-group list-group-flush">
                @foreach (var project in Model.CurrentProjects)
                {
                    <div class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div><span class="dashboard-project-label">Assigned project</span><h3 class="dashboard-project-name">@project.ProjectName</h3></div>
                        <a asp-controller="Project" asp-action="Detail" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-primary">View project</a>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="dashboard-empty-state mb-4"><strong>No projects assigned</strong><p class="mb-0">Your projects will appear here when your manager assigns them.</p></div>
    }

    <h2 class="dashboard-section-title">Quick access</h2>
    <div class="row g-3">
        <div class="col-sm-6 col-xl-4"><a class="dashboard-action-card" asp-controller="Timesheet" asp-action="Index"><span class="dashboard-action-icon">T</span><h3>Timesheets</h3><p>Record and review your working hours.</p><span class="dashboard-action-link">Open timesheets →</span></a></div>
        <div class="col-sm-6 col-xl-4"><a class="dashboard-action-card" asp-controller="Leave" asp-action="Index"><span class="dashboard-action-icon">L</span><h3>Leave requests</h3><p>Submit a leave request and check its status.</p><span class="dashboard-action-link">Manage leave →</span></a></div>
        <div class="col-sm-6 col-xl-4"><a class="dashboard-action-card" asp-controller="Expense" asp-action="Index"><span class="dashboard-action-icon">$</span><h3>Expenses</h3><p>Submit and track your expense claims.</p><span class="dashboard-action-link">View expenses →</span></a></div>
        <div class="col-sm-6 col-xl-4"><a class="dashboard-action-card" asp-controller="HelpDesk" asp-action="Index"><span class="dashboard-action-icon">?</span><h3>Help Desk</h3><p>Ask for support and follow your requests.</p><span class="dashboard-action-link">Open Help Desk →</span></a></div>
        <div class="col-sm-6 col-xl-4"><a class="dashboard-action-card" asp-controller="Account" asp-action="Profile"><span class="dashboard-action-icon">P</span><h3>My profile</h3><p>Review your contact and employee details.</p><span class="dashboard-action-link">View profile →</span></a></div>
    </div>
</div>
