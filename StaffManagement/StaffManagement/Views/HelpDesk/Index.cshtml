@using StaffManagement.Core.DTOs
@using StaffManagement.Model.Enums
@model PagedResultDto<StaffManagement.Core.DTOs.HelpDeskModel.HelpDeskTicketDto>
@{
    ViewData["Title"] = "Help Desk";
    var canManageTickets = User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Technical Support");
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">REQUESTS</p>
        <h1 class="mb-1">Help Desk</h1>
        <p class="text-muted mb-0">Submit and track employee support tickets.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create ticket</a>
</div>
@if (Model.Items.Count > 0)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-sm-5 col-md-4">
                    <label for="helpDeskTypeFilter" class="form-label">Filter by ticket type</label>
                    <select id="helpDeskTypeFilter" class="form-select">
                        <option value="">All ticket types</option>
                        @foreach (var ticketType in Enum.GetValues<HelpDeskTicketType>())
                        {
                            <option value="@ticketType">@ticketType</option>
                        }
                    </select>
                </div>
                <div class="col-sm-5 col-md-4">
                    <label for="helpDeskStatusFilter" class="form-label">Filter by ticket status</label>
                    <select id="helpDeskStatusFilter" class="form-select">
                        <option value="">All ticket statuses</option>
                        @foreach (var status in Enum.GetValues<HelpDeskStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-sm-2 col-md-4">
                    <button id="helpDeskResetFilters" type="button" class="btn btn-outline-secondary">Reset search</button>
                </div>
            </div>
        </div>
    </div>
}
<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table id="helpDeskTable" class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th class="text-center">S.No.</th><th>First name</th><th>Ticket type</th><th>Date</th><th>Update date</th><th>Ticket status</th><th>Description</th><th class="text-center">Action</th></tr></thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="8" class="text-center text-muted py-4">No Help Desk tickets found.</td></tr>
        }
        else
        {
            @foreach (var ticket in Model.Items.Select((item, index) => new { Item = item, Index = (Model.PageNumber - 1) * Model.PageSize + index + 1 }))
            {
                <tr>
                    <td class="text-center">@ticket.Index</td>
                    <td>@ticket.Item.FirstName</td>
                    <td>@ticket.Item.TicketType</td>
                    <td data-order="@ticket.Item.Date.ToString("O")">@ticket.Item.Date.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td data-order="@(ticket.Item.UpdateDate?.ToString("O") ?? string.Empty)">@(ticket.Item.UpdateDate?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</td>
                    <td><span class="badge @(ticket.Item.Status == HelpDeskStatus.Resolved || ticket.Item.Status == HelpDeskStatus.Closed || ticket.Item.Status == HelpDeskStatus.NotFixed ? "text-bg-success" : ticket.Item.Status == HelpDeskStatus.InProgress ? "text-bg-info" : "text-bg-warning")">@(ticket.Item.Status == HelpDeskStatus.NotFixed ? "Not Fixed" : ticket.Item.Status)</span></td>
                    <td class="text-break">@ticket.Item.Description</td>
                    <td class="text-center text-nowrap">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for ticket @ticket.Item.Id" title="Actions">
                                <span aria-hidden="true">&#8942;</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a asp-action="Details" asp-route-id="@ticket.Item.Id" class="dropdown-item">View</a></li>
                                @if (canManageTickets && ticket.Item.Status != HelpDeskStatus.Closed)
                                {
                                    <li><button type="button" class="dropdown-item edit-ticket-status" data-bs-toggle="modal" data-bs-target="#editTicketStatusModal" data-ticket-id="@ticket.Item.Id" data-ticket-status="@ticket.Item.Status">Edit status</button></li>
                                }
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div></div>
@if (canManageTickets)
{
    <div class="modal fade" id="editTicketStatusModal" tabindex="-1" aria-labelledby="editTicketStatusModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" id="editTicketId" name="id" />
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="editTicketStatusModalLabel">Edit ticket status</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label for="editTicketStatus" class="form-label">Status</label>
                        <select id="editTicketStatus" name="status" class="form-select" required>
                            @foreach (var status in Enum.GetValues<HelpDeskStatus>())
                            {
                                <option value="@status">@(status == HelpDeskStatus.NotFixed ? "Not Fixed" : status.ToString())</option>
                            }
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save status</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Help Desk pages"><ul class="pagination">
        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">Previous</a></li>
        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
        {
            <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@pageNumber">@pageNumber</a></li>
        }
        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">Next</a></li>
    </ul></nav>
}
@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.css" />
}
@section Scripts {
    <script src="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.js"></script>
    <script>
        if (document.querySelector('#helpDeskTable tbody tr td[colspan]') === null) {
            const helpDeskTable = new DataTable('#helpDeskTable', {
                paging: false,
                info: false,
                lengthChange: false,
                columnDefs: [{ targets: [0, -1], orderable: false, searchable: false }],
                drawCallback: function () {
                    const api = this.api();
                    const offset = (@Model.PageNumber - 1) * @Model.PageSize;
                    api.column(0, { order: 'applied', search: 'applied' }).nodes().each(function (cell, index) {
                        cell.textContent = offset + index + 1;
                    });
                }
            });

            document.getElementById('helpDeskTypeFilter').addEventListener('change', function () {
                const value = this.value;
                helpDeskTable.column(2).search(value ? '^' + value + '$' : '', true, false).draw();
            });
            document.getElementById('helpDeskStatusFilter').addEventListener('change', function () {
                const value = this.value;
                helpDeskTable.column(5).search(value ? '^' + value + '$' : '', true, false).draw();
            });
            document.getElementById('helpDeskResetFilters').addEventListener('click', function () {
                document.getElementById('helpDeskTypeFilter').value = '';
                document.getElementById('helpDeskStatusFilter').value = '';
                helpDeskTable.search('').columns().search('').draw();
                const searchInput = document.querySelector('#helpDeskTable_wrapper .dt-search input');
                if (searchInput) searchInput.value = '';
            });
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["Success"] is string success)
    {
        <script>Swal.fire({ icon: 'success', title: 'Success', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(success)), timer: 2200, showConfirmButton: false });</script>
    }
    @if (TempData["Error"] is string error)
    {
        <script>Swal.fire({ icon: 'error', title: 'Unable to complete action', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(error)) });</script>
    }
    <script>
        document.querySelectorAll('.edit-ticket-status').forEach(button => {
            button.addEventListener('click', () => {
                document.getElementById('editTicketId').value = button.dataset.ticketId;
                document.getElementById('editTicketStatus').value = button.dataset.ticketStatus;
            });
        });
    </script>
}
