@using StaffManagement.Model.Enums
@model StaffManagement.Core.DTOs.HelpDeskModel.CreateHelpDeskTicketDto
@{
    ViewData["Title"] = "Create Help Desk ticket";
}
<div class="mb-4">
    <p class="text-primary fw-semibold mb-1">REQUESTS / HELP DESK</p>
    <h1 class="mb-1">Create a ticket</h1>
    <p class="text-muted mb-0">Describe the support you need. You can attach a supporting document.</p>
</div>
<div class="card border-0 shadow-sm"><div class="card-body">
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-md-6">
            <label asp-for="TicketType" class="form-label">Ticket type <span class="text-danger">*</span></label>
            <select asp-for="TicketType" class="form-select" asp-items="@(Html.GetEnumSelectList<HelpDeskTicketType>())" required><option value="">-- Select ticket type --</option></select>
            <span asp-validation-for="TicketType" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Status" class="form-label">Status <span class="text-danger">*</span></label>
            <select asp-for="Status" class="form-select" asp-items="@(Html.GetEnumSelectList<HelpDeskStatus>())" required></select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">Description <span class="text-danger">*</span></label>
            <textarea asp-for="Description" class="form-control" rows="5" maxlength="2000" required placeholder="Describe the issue and any steps you have already tried."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label for="document" class="form-label">Document</label>
            <input type="file" id="document" name="document" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg" />
            <div class="form-text">PDF, Word, Excel, PNG, or JPEG; maximum size 10 MB.</div>
            <span class="text-danger">@Html.ValidationMessage("document")</span>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Submit ticket</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
