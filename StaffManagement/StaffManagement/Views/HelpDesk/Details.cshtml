@using StaffManagement.Model.Enums
@model StaffManagement.Core.DTOs.HelpDeskModel.HelpDeskTicketDto
@{
    ViewData["Title"] = "Help Desk ticket details";
    var statusClass = Model.Status switch
    {
        HelpDeskStatus.Resolved or HelpDeskStatus.Closed or HelpDeskStatus.NotFixed => "text-bg-success",
        HelpDeskStatus.InProgress => "text-bg-info",
        _ => "text-bg-warning"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">REQUEST DETAILS</p>
        <h1 class="mb-1">Help Desk ticket</h1>
        <p class="text-muted mb-0">Ticket #@Model.Id</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Help Desk</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Employee</dt><dd class="col-sm-9">@Model.FirstName</dd>
            <dt class="col-sm-3">Ticket type</dt><dd class="col-sm-9">@Model.TicketType</dd>
            <dt class="col-sm-3">Submitted</dt><dd class="col-sm-9">@Model.Date.ToLocalTime().ToString("f")</dd>
            <dt class="col-sm-3">Last updated</dt><dd class="col-sm-9">@(Model.UpdateDate?.ToLocalTime().ToString("f") ?? "Not updated")</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge @statusClass">@(Model.Status == HelpDeskStatus.NotFixed ? "Not Fixed" : Model.Status.ToString())</span></dd>
            <dt class="col-sm-3">Description</dt><dd class="col-sm-9 text-break" style="white-space: pre-wrap">@Model.Description</dd>
            <dt class="col-sm-3">Document</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.DocumentPath))
                {
                    <a asp-action="Document" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Download attachment</a>
                }
                else
                {
                    <span class="text-muted">No attachment</span>
                }
            </dd>
        </dl>
    </div>
</div>
