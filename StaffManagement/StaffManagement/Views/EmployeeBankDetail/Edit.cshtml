@model StaffManagement.Core.DTOs.ProfileModel.BankDetailsDto
@{ ViewData["Title"] = "Edit bank details"; }
<div class="mb-4"><h1 class="h2">Edit Bank Details</h1><div class="small text-muted"><span class="text-danger">*</span> Required field</div><p class="text-muted mb-0">@ViewBag.EmployeeName</p></div>
<div class="card profile-card"><div class="card-body"><form asp-action="Edit" method="post"><input asp-for="EmployeeBankDetailId" type="hidden" /><input asp-for="EmployeeId" type="hidden" /><input type="hidden" name="returnToEditProfile" value="@(ViewBag.ReturnToEditProfile is true ? "true" : "false")" /><input type="hidden" name="returnToEmployeeDetails" value="@(ViewBag.ReturnToEmployeeDetails is true ? "true" : "false")" />
<div class="row g-3"><div class="col-md-6"><label asp-for="AccountHolderName" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span><input asp-for="AccountHolderName" class="form-control" required maxlength="150" /><span asp-validation-for="AccountHolderName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AccountName" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span><input asp-for="AccountName" class="form-control" required maxlength="150" /><span asp-validation-for="AccountName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="IFSCCode" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span><input asp-for="IFSCCode" class="form-control text-uppercase" required minlength="11" maxlength="11" autocomplete="off" /><span asp-validation-for="IFSCCode" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Branch" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span><input asp-for="Branch" class="form-control" required maxlength="150" /><span asp-validation-for="Branch" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AccountNumber" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span><input asp-for="AccountNumber" class="form-control" required minlength="6" maxlength="34" inputmode="numeric" autocomplete="off" /><span asp-validation-for="AccountNumber" class="text-danger"></span></div></div>
<div class="mt-4"><button type="submit" class="btn btn-primary">Save changes</button> @if (ViewBag.ReturnToEmployeeDetails is true) { <a asp-controller="Employee" asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-outline-secondary">Cancel</a> } else { <a asp-controller="Account" asp-action="@(ViewBag.ReturnToEditProfile is true ? "EditProfile" : "Profile")" class="btn btn-outline-secondary">Cancel</a> }</div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

