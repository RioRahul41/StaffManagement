@model StaffManagement.Models.HolidayListViewModel
@using StaffManagement.Core.Security
@{
    ViewData["Title"] = "Holiday calendar";
    var canManageHolidays = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Hr);
}

<div class="mb-4">
    <p class="text-primary fw-semibold mb-1">STAFF RESOURCES</p>
    <h1 class="mb-2">Holiday calendar</h1>
    <p class="text-muted mb-0">Check upcoming and past company holidays.</p>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (canManageHolidays)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h5">Add a holiday</h2>
            <form asp-action="Create" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-md-4">
                    <label asp-for="HolidayName" class="form-label">Holiday name <span class="text-danger" aria-hidden="true">*</span></label>
                    <input asp-for="HolidayName" class="form-control" maxlength="120" placeholder="e.g. Independence Day" />
                    <span asp-validation-for="HolidayName" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="HolidayDate" class="form-label">Holiday date <span class="text-danger" aria-hidden="true">*</span></label>
                    <input asp-for="HolidayDate" type="date" class="form-control" />
                    <span asp-validation-for="HolidayDate" class="text-danger"></span>
                </div>
                
                <div class="col-12"><button type="submit" class="btn btn-primary">Add holiday</button></div>
            </form>
        </div>
    </div>
}

<section aria-labelledby="holiday-list-heading">
    <h2 id="holiday-list-heading" class="h4 mb-3">Holiday dates</h2>
    @if (Model.Holidays.Count == 0)
    {
        <div class="card border-0 shadow-sm"><div class="card-body text-muted">No holidays have been added yet.</div></div>
    }
    else
    {
        <div class="table-responsive card border-0 shadow-sm">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="text-center">S.No.</th>
                        <th scope="col">Date</th>
                        <th scope="col">Holiday</th>
                        @if (canManageHolidays)
                        {
                            <th scope="col">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var holiday in Model.Holidays.Select((item, index) => new { Item = item, Index = index + 1 }))
                    {
                        <tr>
                            <td class="text-center">@holiday.Index</td>
                            <td><time datetime="@(holiday.Item.HolidayDate.ToString("yyyy-MM-dd"))">@holiday.Item.HolidayDate.ToString("ddd, dd MMM yyyy")</time></td>
                            <td class="fw-semibold">@holiday.Item.HolidayName</td>
                            @if (canManageHolidays)
                            {
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for @holiday.Item.HolidayName" title="Actions">
                                            <span aria-hidden="true">&#8942;</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <button type="button" class="dropdown-item edit-holiday-date"
                                                        data-bs-toggle="modal" data-bs-target="#editHolidayDateModal"
                                                        data-holiday-id="@holiday.Item.Id"
                                                        data-holiday-name="@holiday.Item.HolidayName"
                                                        data-holiday-date="@holiday.Item.HolidayDate.ToString("yyyy-MM-dd")">
                                                    Edit date
                                                </button>
                                            </li>
                                            <li>
                                                <form asp-action="Delete" asp-route-id="@holiday.Item.Id" method="post" onsubmit="return confirm('Remove this holiday from the calendar?');">
                                                    <button type="submit" class="dropdown-item text-danger">Remove</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (canManageHolidays)
{
    <div class="modal fade" id="editHolidayDateModal" tabindex="-1" aria-labelledby="editHolidayDateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="EditDate" method="post">
                    <input type="hidden" id="editHolidayId" name="id" />
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="editHolidayDateModalLabel">Edit holiday date</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p id="editHolidayName" class="text-muted"></p>
                        <label for="editHolidayDate" class="form-label">Holiday date</label>
                        <input type="date" id="editHolidayDate" name="holidayDate" class="form-control" required />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save date</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.edit-holiday-date').forEach(button => {
            button.addEventListener('click', () => {
                document.getElementById('editHolidayId').value = button.dataset.holidayId;
                document.getElementById('editHolidayDate').value = button.dataset.holidayDate;
                document.getElementById('editHolidayName').textContent = button.dataset.holidayName;
            });
        });
    </script>
}
