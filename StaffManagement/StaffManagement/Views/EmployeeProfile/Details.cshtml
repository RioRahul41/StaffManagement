@model StaffManagement.Model.Entities.EmployeeProfile
@{ ViewData["Title"] = "Profile Information"; var successMessage = TempData["Success"] as string; }
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1>Profile Information</h1><p class="text-muted mb-0">@Model.Employee.FirstName @Model.Employee.LastName</p></div>@if (ViewBag.CanDeleteProfile is true) { <a asp-action="Delete" asp-route-employeeId="@Model.EmployeeId" class="btn btn-outline-danger">Delete</a> }</div>
<div class="card profile-card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Profile Information</h2>@if (ViewBag.CanEditProfile is true) { <a asp-action="Edit" asp-route-employeeId="@Model.EmployeeId" asp-route-section="profile" class="btn btn-outline-primary btn-sm">Edit</a> }</div><div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 profile-info-grid"><div class="col"><div class="profile-info-item"><div class="profile-info-label">Gender</div><div class="profile-info-value">@(Model.Gender?.ToString() ?? "Not provided")</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Marital status</div><div class="profile-info-value">@(Model.MaritalStatus ?? "Not provided")</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Date of birth</div><div class="profile-info-value">@(Model.DOB?.ToString("d") ?? "Not provided")</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Blood group</div><div class="profile-info-value">@(Model.BloodGroup ?? "Not provided")</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Phone number</div><div class="profile-info-value">@(Model.PhoneNumber ?? "Not provided")</div></div></div></div></div></div>
<div class="card profile-card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Emergency Contact Person</h2>@if (ViewBag.CanEditProfile is true) { <a asp-action="Edit" asp-route-employeeId="@Model.EmployeeId" asp-route-section="emergency" class="btn btn-outline-primary btn-sm">Edit</a> }</div><div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 profile-info-grid"><div class="col"><div class="profile-info-item"><div class="profile-info-label">Name</div><div class="profile-info-value">@(Model.EmergencyContactName ?? "Not provided")</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Relationship</div><div class="profile-info-value">@(Model.EmergencyContactRelationship ?? "Not provided")</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Phone number</div><div class="profile-info-value">@(Model.EmergencyContactPhone ?? "Not provided")</div></div></div></div></div></div>
<div class="card profile-card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Address Information</h2></div><div class="row g-4">
    <div class="col-md-6"><h3 class="h6 mb-3">Permanent Address</h3><div class="row row-cols-1 row-cols-sm-2 g-3">
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Address Line 1</div><div class="profile-info-value">@(Model.PermanentAddressLine1 ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Address Line 2</div><div class="profile-info-value">@(Model.PermanentAddressLine2 ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Country</div><div class="profile-info-value">@(Model.PermanentCountry ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">State</div><div class="profile-info-value">@(Model.PermanentState ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">City</div><div class="profile-info-value">@(Model.PermanentCity ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Pin Code</div><div class="profile-info-value">@(Model.PermanentPincode ?? "Not provided")</div></div></div>
    </div></div>
    <div class="col-md-6"><h3 class="h6 mb-3">Current Address</h3><div class="row row-cols-1 row-cols-sm-2 g-3">
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Address Line 1</div><div class="profile-info-value">@(Model.CurrentAddressLine1 ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Address Line 2</div><div class="profile-info-value">@(Model.CurrentAddressLine2 ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Country</div><div class="profile-info-value">@(Model.CurrentCountry ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">State</div><div class="profile-info-value">@(Model.CurrentState ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">City</div><div class="profile-info-value">@(Model.CurrentCity ?? "Not provided")</div></div></div>
        <div class="col"><div class="profile-info-item"><div class="profile-info-label">Pin Code</div><div class="profile-info-value">@(Model.CurrentPincode ?? "Not provided")</div></div></div>
    </div></div>
</div></div></div>
<div class="card profile-card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Other Details</h2>@if (ViewBag.CanManageOtherDetails is true) { <a asp-controller="EmployeeOtherDetail" asp-action="Create" asp-route-employeeId="@Model.EmployeeId" class="btn btn-outline-primary btn-sm">Add Document</a> }</div>
@{ var documents = ViewBag.OtherDetails as IReadOnlyList<StaffManagement.Model.Entities.EmployeeOtherDetail> ?? Array.Empty<StaffManagement.Model.Entities.EmployeeOtherDetail>(); }
@if (documents.Count == 0) { <p class="text-muted mb-0">No documents have been added yet.</p> } else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Document Type</th><th>Document Number</th><th>Valid From</th><th>Valid To</th><th class="text-end">Action</th></tr></thead><tbody>@foreach (var document in documents) { <tr><td>@document.DocumentType</td><td>@document.DocumentNumber</td><td>@(document.ValidFrom?.ToString("d") ?? "Not provided")</td><td>@(document.ValidTo?.ToString("d") ?? "Not provided")</td><td class="text-end">@if (ViewBag.CanManageOtherDetails is true) { <a asp-controller="EmployeeOtherDetail" asp-action="Download" asp-route-id="@document.EmployeeOtherDetailId" class="btn btn-sm btn-outline-primary" title="Download document" aria-label="Download @document.DocumentType"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M.5 9.9v3.6c0 .8.7 1.5 1.5 1.5h12c.8 0 1.5-.7 1.5-1.5V9.9h-1.5v3.6H2V9.9z"/><path d="M7.25 0h1.5v8.1l2.3-2.3 1.1 1.1L8 11.05 3.85 6.9l1.1-1.1 2.3 2.3z"/></svg></a> } else { <span class="text-muted">—</span> }</td></tr> }</tbody></table></div> }</div></div><div class="card profile-card profile-experience-card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Experience Information</h2>@if (ViewBag.CanEditProfile is true) { <a asp-controller="EmployeeExperience" asp-action="Create" asp-route-employeeId="@Model.EmployeeId" asp-route-returnToEmployeeDetails="true" class="btn btn-outline-primary btn-sm">Add Experience</a> }</div>
@{ var experiences = ViewBag.EmployeeExperiences as IReadOnlyList<StaffManagement.Model.Entities.EmployeeExperience> ?? Array.Empty<StaffManagement.Model.Entities.EmployeeExperience>(); }
@if (experiences.Count == 0) { <p class="text-muted mb-0">No experience information has been added yet.</p> } else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Previous company</th><th>Date of joining</th><th>Date of relieving</th><th class="text-end">Action</th></tr></thead><tbody>@foreach (var item in experiences) { <tr><td>@item.PreviousCompany</td><td>@item.DateOfJoining?.ToString("d")</td><td>@item.DateOfRelieving?.ToString("d")</td><td class="text-end"><div class="dropdown"><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for @item.PreviousCompany">⋮</button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-controller="EmployeeExperience" asp-action="Details" asp-route-id="@item.EmployeeExperienceId" asp-route-returnToEmployeeDetails="true">View</a></li></ul></div></td></tr> }</tbody></table></div> }
</div></div><div class="card profile-card profile-bank-card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Bank Details</h2>@{ var bankDetails = ViewBag.BankDetails as StaffManagement.Core.DTOs.ProfileModel.BankDetailsDto; }@if (bankDetails is null) { @if (ViewBag.CanEditProfile is true) { <a asp-controller="EmployeeBankDetail" asp-action="Create" asp-route-employeeId="@Model.EmployeeId" asp-route-returnToEmployeeDetails="true" class="btn btn-outline-primary btn-sm">Add Bank Details</a> } } else { <div><a asp-controller="EmployeeBankDetail" asp-action="Details" asp-route-employeeId="@Model.EmployeeId" asp-route-returnToEmployeeDetails="true" class="btn btn-outline-secondary btn-sm me-2">View</a>@if (ViewBag.CanEditProfile is true) {  }</div> }</div>
@if (bankDetails is null) { <p class="text-muted mb-0">No bank details have been added yet.</p> } else { <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 profile-info-grid"><div class="col"><div class="profile-info-item"><div class="profile-info-label">Account holder name</div><div class="profile-info-value">@bankDetails.AccountHolderName</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Account name</div><div class="profile-info-value">@bankDetails.AccountName</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">IFSC code</div><div class="profile-info-value">@bankDetails.IFSCCode</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Branch</div><div class="profile-info-value">@bankDetails.Branch</div></div></div><div class="col"><div class="profile-info-item"><div class="profile-info-label">Account number</div><div class="profile-info-value">@bankDetails.AccountNumber</div></div></div></div> }
</div></div><a asp-controller="Employee" asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-secondary">Back to employee</a>

@section Scripts {
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>Swal.fire({ icon: 'success', title: 'Saved', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)), timer: 2400, showConfirmButton: false });</script>
    }
}






