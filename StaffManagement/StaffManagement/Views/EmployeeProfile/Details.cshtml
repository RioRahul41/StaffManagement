@model StaffManagement.Model.Entities.EmployeeProfile
@{ ViewData["Title"] = "Profile Information"; }
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="d-flex justify-content-between align-items-start mb-4"><div><h1>Profile Information</h1><p class="text-muted mb-0">@Model.Employee.FirstName @Model.Employee.LastName</p></div>@if (ViewBag.CanDeleteProfile is true) { <a asp-action="Delete" asp-route-employeeId="@Model.EmployeeId" class="btn btn-outline-danger">Delete</a> }</div>
<div class="card profile-card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Profile Information</h2>@if (ViewBag.CanEditProfile is true) { <a asp-action="Edit" asp-route-employeeId="@Model.EmployeeId" asp-route-section="profile" class="btn btn-outline-primary btn-sm">Edit</a> }</div><dl class="row mb-0"><dt class="col-sm-4">Gender</dt><dd class="col-sm-8">@(Model.Gender?.ToString() ?? "Not provided")</dd><dt class="col-sm-4">Marital status</dt><dd class="col-sm-8">@(Model.MaritalStatus ?? "Not provided")</dd><dt class="col-sm-4">Date of birth</dt><dd class="col-sm-8">@(Model.DOB?.ToString("d") ?? "Not provided")</dd><dt class="col-sm-4">Blood group</dt><dd class="col-sm-8">@(Model.BloodGroup ?? "Not provided")</dd><dt class="col-sm-4">Phone number</dt><dd class="col-sm-8">@(Model.PhoneNumber ?? "Not provided")</dd></dl></div></div>
<div class="card profile-card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Emergency Contact Person</h2>@if (ViewBag.CanEditProfile is true) { <a asp-action="Edit" asp-route-employeeId="@Model.EmployeeId" asp-route-section="emergency" class="btn btn-outline-primary btn-sm">Edit</a> }</div><dl class="row mb-0"><dt class="col-sm-4">Name</dt><dd class="col-sm-8">@(Model.EmergencyContactName ?? "Not provided")</dd><dt class="col-sm-4">Relationship</dt><dd class="col-sm-8">@(Model.EmergencyContactRelationship ?? "Not provided")</dd><dt class="col-sm-4">Phone number</dt><dd class="col-sm-8">@(Model.EmergencyContactPhone ?? "Not provided")</dd></dl></div></div>
<div class="card profile-card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Address Information</h2>@if (ViewBag.CanEditProfile is true) { <a asp-action="Edit" asp-route-employeeId="@Model.EmployeeId" asp-route-section="address" class="btn btn-outline-primary btn-sm">Edit</a> }</div><div class="row g-4">
    <div class="col-md-6"><h3 class="h6 mb-3">Permanent Address</h3><div class="row g-3">
        <div class="col-12"><div class="small text-muted">Address Line 1</div><div>@(Model.PermanentAddressLine1 ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">Address Line 2</div><div>@(Model.PermanentAddressLine2 ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">Country</div><div>@(Model.PermanentCountry ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">State</div><div>@(Model.PermanentState ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">City</div><div>@(Model.PermanentCity ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">Pin Code</div><div>@(Model.PermanentPincode ?? "Not provided")</div></div>
    </div></div>
    <div class="col-md-6"><h3 class="h6 mb-3">Current Address</h3><div class="row g-3">
        <div class="col-12"><div class="small text-muted">Address Line 1</div><div>@(Model.CurrentAddressLine1 ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">Address Line 2</div><div>@(Model.CurrentAddressLine2 ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">Country</div><div>@(Model.CurrentCountry ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">State</div><div>@(Model.CurrentState ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">City</div><div>@(Model.CurrentCity ?? "Not provided")</div></div>
        <div class="col-12"><div class="small text-muted">Pin Code</div><div>@(Model.CurrentPincode ?? "Not provided")</div></div>
    </div></div>
</div></div></div>
<div class="card profile-card mb-4"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h4 mb-0">Other Details</h2>@if (ViewBag.CanManageOtherDetails is true) { <a asp-controller="EmployeeOtherDetail" asp-action="Create" asp-route-employeeId="@Model.EmployeeId" class="btn btn-outline-primary btn-sm">Add Document</a> }</div>
@{ var documents = ViewBag.OtherDetails as IReadOnlyList<StaffManagement.Model.Entities.EmployeeOtherDetail> ?? Array.Empty<StaffManagement.Model.Entities.EmployeeOtherDetail>(); }
@if (documents.Count == 0) { <p class="text-muted mb-0">No documents have been added yet.</p> } else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Document Type</th><th>Document Number</th><th>Valid From</th><th>Valid To</th><th class="text-end">Action</th></tr></thead><tbody>@foreach (var document in documents) { <tr><td>@document.DocumentType</td><td>@document.DocumentNumber</td><td>@(document.ValidFrom?.ToString("d") ?? "Not provided")</td><td>@(document.ValidTo?.ToString("d") ?? "Not provided")</td><td class="text-end">@if (ViewBag.CanManageOtherDetails is true) { <a asp-controller="EmployeeOtherDetail" asp-action="Download" asp-route-id="@document.EmployeeOtherDetailId" class="btn btn-sm btn-outline-primary" title="Download document" aria-label="Download @document.DocumentType"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M.5 9.9v3.6c0 .8.7 1.5 1.5 1.5h12c.8 0 1.5-.7 1.5-1.5V9.9h-1.5v3.6H2V9.9z"/><path d="M7.25 0h1.5v8.1l2.3-2.3 1.1 1.1L8 11.05 3.85 6.9l1.1-1.1 2.3 2.3z"/></svg></a> } else { <span class="text-muted">—</span> }</td></tr> }</tbody></table></div> }</div></div><a asp-controller="Employee" asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-secondary">Back to employee</a>



