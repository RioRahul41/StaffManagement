@model IReadOnlyList<StaffManagement.Model.Entities.EmployeeProfile>
@{ ViewData["Title"] = "Employee profiles"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="mb-1">Employee profiles</h1><p class="text-muted mb-0">Manage employee profile information and emergency contacts.</p></div>
    @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Manager")) { <a asp-action="Create" class="btn btn-primary">Add profile information</a> }
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Employee</th><th>Gender</th><th>Phone</th><th>Emergency contact</th><th>Actions</th></tr></thead><tbody>
@foreach (var profile in Model)
{
    <tr><td>@profile.Employee.FirstName @profile.Employee.LastName</td><td>@(profile.Gender?.ToString() ?? "Not provided")</td><td>@(profile.PhoneNumber ?? "Not provided")</td><td>@(profile.EmergencyContactName ?? "Not provided")</td><td><a asp-action="Details" asp-route-employeeId="@profile.EmployeeId" class="btn btn-sm btn-outline-primary">View</a> @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Manager")) { <a asp-action="Edit" asp-route-employeeId="@profile.EmployeeId" class="btn btn-sm btn-outline-secondary">Edit</a> <a asp-action="Delete" asp-route-employeeId="@profile.EmployeeId" class="btn btn-sm btn-outline-danger">Delete</a> }</td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">No employee profiles have been added.</td></tr> }
</tbody></table></div></div>
