@model StaffManagement.Core.DTOs.ProfileModel.EmployeeProfileDto
@using StaffManagement.Model.Enums
@{
    var editSection = ViewBag.EditSection as string ?? "profile";
    var isEmergency = editSection == "emergency";
    var isAddress = editSection == "address";
}
<h1>@ViewData["Title"]</h1>
<p class="text-muted">@Model.EmployeeName</p>
<form asp-action="Edit" asp-route-employeeId="@Model.EmployeeId" asp-route-section="@editSection" method="post" class="card profile-card">
    <input asp-for="EmployeeId" type="hidden" />
    <input type="hidden" name="returnToProfile" value="@(ViewBag.ReturnToProfile is true ? "true" : "false")" /><input type="hidden" name="returnToEditProfile" value="@(ViewBag.ReturnToEditProfile is true ? "true" : "false")" />
    <div class="card-body row g-3">
        @if (isEmergency)
        {
            <div class="col-12"><h2 class="h5">Emergency Contact Person</h2></div>
            <div class="col-md-4"><label asp-for="ProfileInformation.EmergencyContactName" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="ProfileInformation.EmergencyContactName" class="form-control" required aria-required="true" /><span asp-validation-for="ProfileInformation.EmergencyContactName" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="ProfileInformation.EmergencyContactRelationship" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><select asp-for="ProfileInformation.EmergencyContactRelationship" class="form-select" required aria-required="true"><option value="">Select relationship</option>@if (!string.IsNullOrWhiteSpace(Model.ProfileInformation.EmergencyContactRelationship) && !Enum.GetNames<EmergencyContactRelationship>().Contains(Model.ProfileInformation.EmergencyContactRelationship, StringComparer.OrdinalIgnoreCase)) { <option value="@Model.ProfileInformation.EmergencyContactRelationship">@Model.ProfileInformation.EmergencyContactRelationship</option> }@foreach (var relationship in Enum.GetValues<EmergencyContactRelationship>()) { <option value="@relationship">@relationship</option> }</select><span asp-validation-for="ProfileInformation.EmergencyContactRelationship" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="ProfileInformation.EmergencyContactPhone" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="ProfileInformation.EmergencyContactPhone" type="tel" inputmode="numeric" maxlength="10" pattern="[0-9]{10}" data-phone-number placeholder="10-digit number" class="form-control" required aria-required="true" /><span asp-validation-for="ProfileInformation.EmergencyContactPhone" class="text-danger"></span></div>
        }
        else if (isAddress)
        {
            <div class="col-12"><h2 class="h5">Address Information</h2></div>
            <div class="col-12"><h3 class="h6">Permanent Address</h3></div>
            <div class="col-md-6"><label asp-for="AddressInformation.PermanentAddressLine1" class="form-label">Address Line 1</label><span class="text-danger" aria-hidden="true">*</span><input asp-for="AddressInformation.PermanentAddressLine1" class="form-control" required aria-required="true" /><span asp-validation-for="AddressInformation.PermanentAddressLine1" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="AddressInformation.PermanentAddressLine2" class="form-label">Address Line 2</label><input asp-for="AddressInformation.PermanentAddressLine2" class="form-control" /><span asp-validation-for="AddressInformation.PermanentAddressLine2" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="AddressInformation.PermanentCountry" class="form-label">Country</label><span class="text-danger" aria-hidden="true">*</span><input asp-for="AddressInformation.PermanentCountry" class="form-control" required aria-required="true" /><span asp-validation-for="AddressInformation.PermanentCountry" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="AddressInformation.PermanentState" class="form-label">State</label><span class="text-danger" aria-hidden="true">*</span><input asp-for="AddressInformation.PermanentState" class="form-control" required aria-required="true" /><span asp-validation-for="AddressInformation.PermanentState" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="AddressInformation.PermanentCity" class="form-label">City</label><span class="text-danger" aria-hidden="true">*</span><input asp-for="AddressInformation.PermanentCity" class="form-control" required aria-required="true" /><span asp-validation-for="AddressInformation.PermanentCity" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="AddressInformation.PermanentPincode" class="form-label">Pin Code</label><span class="text-danger" aria-hidden="true">*</span><input asp-for="AddressInformation.PermanentPincode" class="form-control" required aria-required="true" /><span asp-validation-for="AddressInformation.PermanentPincode" class="text-danger"></span></div>
            <div class="col-12 mt-3"><h3 class="h6">Current Address</h3></div>
            <div class="col-md-6"><label asp-for="AddressInformation.CurrentAddressLine1" class="form-label">Address Line 1</label><span class="text-danger" aria-hidden="true">*</span><input asp-for="AddressInformation.CurrentAddressLine1" class="form-control" required aria-required="true" /><span asp-validation-for="AddressInformation.CurrentAddressLine1" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="AddressInformation.CurrentAddressLine2" class="form-label">Address Line 2</label><input asp-for="AddressInformation.CurrentAddressLine2" class="form-control" /><span asp-validation-for="AddressInformation.CurrentAddressLine2" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="AddressInformation.CurrentCountry" class="form-label">Country</label><span class="text-danger" aria-hidden="true">*</span><input asp-for="AddressInformation.CurrentCountry" class="form-control" required aria-required="true" /><span asp-validation-for="AddressInformation.CurrentCountry" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="AddressInformation.CurrentState" class="form-label">State</label><span class="text-danger" aria-hidden="true">*</span><input asp-for="AddressInformation.CurrentState" class="form-control" required aria-required="true" /><span asp-validation-for="AddressInformation.CurrentState" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="AddressInformation.CurrentCity" class="form-label">City</label><span class="text-danger" aria-hidden="true">*</span><input asp-for="AddressInformation.CurrentCity" class="form-control" required aria-required="true" /><span asp-validation-for="AddressInformation.CurrentCity" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="AddressInformation.CurrentPincode" class="form-label">Pin Code</label><span class="text-danger" aria-hidden="true">*</span><input asp-for="AddressInformation.CurrentPincode" class="form-control" required aria-required="true" /><span asp-validation-for="AddressInformation.CurrentPincode" class="text-danger"></span></div>
        }
        else
        {
            <div class="col-12"><h2 class="h5">Profile Information</h2></div>
            <div class="col-md-6"><label asp-for="ProfileInformation.Gender" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><select asp-for="ProfileInformation.Gender" class="form-select" required aria-required="true" data-val="true" data-val-required="Select a gender."><option value="">Select gender</option>@foreach (var gender in Enum.GetValues<Gender>()) { <option value="@gender">@gender</option> }</select><span asp-validation-for="ProfileInformation.Gender" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="ProfileInformation.MaritalStatus" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><select asp-for="ProfileInformation.MaritalStatus" class="form-select" required aria-required="true" data-val="true" data-val-required="Select a marital status."><option value="">Select marital status</option><option>Single</option><option>Married</option><option>Divorced</option><option>Widowed</option></select><span asp-validation-for="ProfileInformation.MaritalStatus" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="ProfileInformation.DOB" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><input asp-for="ProfileInformation.DOB" type="date" class="form-control" required aria-required="true" data-val="true" data-val-required="Date of birth is required." /><span asp-validation-for="ProfileInformation.DOB" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="ProfileInformation.BloodGroup" class="form-label"></label><span class="text-danger" aria-hidden="true">*</span><select asp-for="ProfileInformation.BloodGroup" class="form-select" required aria-required="true" data-val="true" data-val-required="Select a blood group."><option value="">Select blood group</option><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select><span asp-validation-for="ProfileInformation.BloodGroup" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="ProfileInformation.PhoneNumber" class="form-label">Phone number</label><span class="text-danger" aria-hidden="true">*</span><input asp-for="ProfileInformation.PhoneNumber" type="tel" inputmode="numeric" maxlength="10" pattern="[0-9]{10}" data-phone-number placeholder="10-digit number" class="form-control" required aria-required="true" data-val="true" data-val-required="Phone number is required." /><span asp-validation-for="ProfileInformation.PhoneNumber" class="text-danger"></span></div>
        }
        <div class="col-12 mt-3"><button type="submit" class="btn btn-primary">Save changes</button> @if (ViewBag.ReturnToEditProfile is true) { <a asp-controller="Account" asp-action="EditProfile" asp-route-section="@(isAddress ? "address" : "profile")" class="btn btn-secondary">Cancel</a> } else if (ViewBag.ReturnToProfile is true) { <a asp-controller="Account" asp-action="Profile" class="btn btn-secondary">Cancel</a> } else { <a asp-action="Details" asp-route-employeeId="@Model.EmployeeId" class="btn btn-secondary">Cancel</a> }</div>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }


