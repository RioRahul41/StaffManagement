@model IReadOnlyList<StaffManagement.Model.Entities.Department>

@{ ViewData["Title"] = "Departments"; }

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.css" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Departments</h1>
        <p class="text-muted mb-0">Manage your organization's departments.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Department
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <h5>No departments found</h5>
                <p class="text-muted">Create the first department to get started.</p>
                <a asp-action="Create" class="btn btn-primary">Create Department</a>
            </div>
        }
        else
        {
            <div class="row g-3 mb-3 align-items-end">
                <div class="col-md-4">
                    <label for="departmentNameFilter" class="form-label">Department</label>
                    <select id="departmentNameFilter" class="form-select">
                        <option value="">All departments</option>
                        @foreach (var name in Model.Select(department => department.DepartmentName).Where(name => !string.IsNullOrWhiteSpace(name)).Distinct().OrderBy(name => name))
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="departmentStatusFilter" class="form-label">Status</label>
                    <select id="departmentStatusFilter" class="form-select">
                        <option value="">All statuses</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="button" id="departmentResetSearch" class="btn btn-outline-secondary">Reset search</button>
                </div>
            </div>
            <div class="table-responsive">
                <table id="departmentTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">S.No.</th>
                            <th>Department Name</th>
                            <th>Description</th>
                            <th>Created Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var department in Model.Select((item, index) => new { Item = item, Index = index + 1 }))
                    {
                        <tr>
                            <td class="text-center"></td>
                            <td class="fw-semibold">@department.Item.DepartmentName</td>
                            <td>@(string.IsNullOrWhiteSpace(department.Item.Description) ? "—" : department.Item.Description)</td>
                            <td>@department.Item.CreatedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge @(department.Item.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(department.Item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Department actions">
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false" style="display:block"><circle cx="8" cy="3" r="1.3"/><circle cx="8" cy="8" r="1.3"/><circle cx="8" cy="13" r="1.3"/></svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a asp-action="Detail" asp-route-id="@department.Item.DepartmentId" class="dropdown-item">Details</a></li>
                                        <li><a asp-action="Edit" asp-route-id="@department.Item.DepartmentId" class="dropdown-item">Edit</a></li>
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@department.Item.DepartmentId" method="post" class="delete-form">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item text-danger">Delete</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (Model.Count > 0)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const table = new DataTable('#departmentTable', {
                    pageLength: 10,
                    columnDefs: [
                        { targets: [0, 5], orderable: false, searchable: false }
                    ],
                    drawCallback: function () {
                        const info = this.api().page.info();
                        this.api().column(0, { page: 'current' }).nodes().each(function (cell, index) {
                            cell.textContent = info.start + index + 1;
                        });
                    }
                });

                document.getElementById('departmentNameFilter').addEventListener('change', function () {
                    table.column(1).search(this.value, { exact: true }).draw();
                });
                document.getElementById('departmentStatusFilter').addEventListener('change', function () {
                    table.column(4).search(this.value, { exact: true }).draw();
                });
                document.getElementById('departmentResetSearch').addEventListener('click', function () {
                    window.location.reload();
                });
            });
        </script>
    }
    @if (TempData["SuccessMessage"] is string)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '@TempData["SuccessMessage"]',
                timer: 2200,
                showConfirmButton: false
            });
        </script>
    }
    <script>
        document.querySelectorAll('.delete-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                Swal.fire({
                    title: 'Delete this department?',
                    text: 'The department will be deactivated.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}
