@using StaffManagement.Core.DTOs.EmployeeModel
@using StaffManagement.Core.DTOs.LeaveModel
@using StaffManagement.Model.Enums
@model IReadOnlyList<LeaveReportDto>
@{
    ViewData["Title"] = "Leave Report";
    var employees = ViewBag.ReportEmployees as IReadOnlyList<EmployeeDto> ?? Array.Empty<EmployeeDto>();
    var leaveTypes = ViewBag.ReportLeaveTypes as IReadOnlyList<string> ?? Array.Empty<string>();
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/4.1.3/css/buttons.dataTables.min.css" />
    <style>
        #leaveReportTable_wrapper .dt-buttons { display: flex; flex-wrap: wrap; gap: .5rem; }
        #leaveReportTable_wrapper .dt-button {
            border: 1px solid #0d6efd; border-radius: .375rem; background: #0d6efd;
            color: #fff; padding: .375rem .75rem;
        }
        #leaveReportTable_wrapper .dt-button:hover { background: #0b5ed7; color: #fff; }
    </style>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">REPORTS</p>
        <h1 class="mb-1">Leave Report</h1>
        <p class="text-muted mb-0">Search, filter, and export employee leave requests.</p>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-sm-6 col-xl-3">
                <label class="form-label" for="employeeFilter">Employee</label>
                <select id="employeeFilter" class="form-select">
                    <option value="">All employees</option>
                    @foreach (var employee in employees)
                    {
                        <option value="@employee.Id">@employee.FirstName @employee.LastName</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="leaveTypeFilter">Leave type</label>
                <select id="leaveTypeFilter" class="form-select">
                    <option value="">All leave types</option>
                    @foreach (var leaveType in leaveTypes)
                    {
                        <option value="@leaveType">@leaveType</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="statusFilter">Status</label>
                <select id="statusFilter" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<LeaveStatus>())
                    {
                        <option value="@((int)status)">@status</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="dateFromFilter">Date from</label>
                <input id="dateFromFilter" type="date" class="form-control" />
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="dateToFilter">Date to</label>
                <input id="dateToFilter" type="date" class="form-control" />
            </div>
            <div class="col-sm-6 col-xl-1">
                <button type="button" id="resetLeaveFilters" class="btn btn-outline-secondary w-100">Reset</button>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table id="leaveReportTable" class="table table-hover align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Leave type</th>
                        <th>From date</th>
                        <th>To date</th>
                        <th>Days</th>
                        <th>Reason</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr data-employee-id="@request.EmployeeId"
                            data-leave-type="@request.LeaveType"
                            data-status="@((int)request.Status)"
                            data-from-date="@request.FromDate.ToString("yyyy-MM-dd")"
                            data-to-date="@request.ToDate.ToString("yyyy-MM-dd")">
                            <td>@request.EmployeeName</td>
                            <td>@request.LeaveType</td>
                            <td data-order="@request.FromDate.ToString("yyyy-MM-dd")">@request.FromDate.ToString("yyyy-MM-dd")</td>
                            <td data-order="@request.ToDate.ToString("yyyy-MM-dd")">@request.ToDate.ToString("yyyy-MM-dd")</td>
                            <td>@request.AppliedDays</td>
                            <td>@request.Reason</td>
                            <td>@request.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/4.1.3/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/4.1.3/js/buttons.html5.min.js"></script>
    <script>
        const employeeFilter = document.getElementById('employeeFilter');
        const leaveTypeFilter = document.getElementById('leaveTypeFilter');
        const statusFilter = document.getElementById('statusFilter');
        const dateFromFilter = document.getElementById('dateFromFilter');
        const dateToFilter = document.getElementById('dateToFilter');

        const leaveReportTable = new DataTable('#leaveReportTable', {
            paging: true,
            pagingType: 'simple_numbers',
            searching: true,
            lengthChange: true,
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50, 100],
            order: [[2, 'desc']],
            scrollX: true,
            layout: {
                topStart: ['pageLength', {
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: 'Export to Excel',
                            title: 'Leave Report',
                            exportOptions: { columns: ':visible', modifier: { search: 'applied', order: 'applied', page: 'all' } }
                        },
                        {
                            extend: 'pdfHtml5',
                            text: 'Download PDF',
                            title: 'Leave Report',
                            orientation: 'landscape',
                            pageSize: 'A4',
                            exportOptions: { columns: ':visible', modifier: { search: 'applied', order: 'applied', page: 'all' } }
                        }
                    ]
                }],
                topEnd: 'search',
                bottomStart: 'info',
                bottomEnd: 'paging'
            },
            language: {
                emptyTable: 'No leave requests found.',
                search: 'Search leave requests:'
            }
        });

        leaveReportTable.search.fixed('leaveReportFilters', (_searchText, _rowData, dataIndex) => {
            const row = leaveReportTable.row(dataIndex).node();
            if (!row) return true;

            const employeeMatches = !employeeFilter.value || row.dataset.employeeId === employeeFilter.value;
            const leaveTypeMatches = !leaveTypeFilter.value || row.dataset.leaveType === leaveTypeFilter.value;
            const statusMatches = !statusFilter.value || row.dataset.status === statusFilter.value;
            const rowFromDate = row.dataset.fromDate || '';
            const rowToDate = row.dataset.toDate || '';
            const fromDateMatches = !dateFromFilter.value || rowToDate >= dateFromFilter.value;
            const toDateMatches = !dateToFilter.value || rowFromDate <= dateToFilter.value;
            return employeeMatches && leaveTypeMatches && statusMatches && fromDateMatches && toDateMatches;
        });

        [employeeFilter, leaveTypeFilter, statusFilter, dateFromFilter, dateToFilter].forEach(filter => {
            filter.addEventListener('change', () => leaveReportTable.draw());
        });
        document.getElementById('resetLeaveFilters').addEventListener('click', () => {
            employeeFilter.value = '';
            leaveTypeFilter.value = '';
            statusFilter.value = '';
            dateFromFilter.value = '';
            dateToFilter.value = '';
            leaveReportTable.search('').order([[2, 'desc']]).page('first').draw();
        });
    </script>
}
