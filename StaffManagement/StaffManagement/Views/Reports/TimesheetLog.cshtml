@using StaffManagement.Core.DTOs.EmployeeModel
@using StaffManagement.Core.DTOs.TimesheetModel
@using StaffManagement.Model.Enums
@model IReadOnlyList<TimesheetLogReportDto>
@{
    ViewData["Title"] = "Timesheet Log Report";
    var employees = ViewBag.ReportEmployees as IReadOnlyList<EmployeeDto> ?? Array.Empty<EmployeeDto>();
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/4.1.3/css/buttons.dataTables.min.css" />
    <style>
        #timesheetLogTable_wrapper .dt-buttons { display: flex; flex-wrap: wrap; gap: .5rem; }
        #timesheetLogTable_wrapper .dt-button {
            border: 1px solid #0d6efd; border-radius: .375rem; background: #0d6efd;
            color: #fff; padding: .375rem .75rem;
        }
        #timesheetLogTable_wrapper .dt-button:hover { background: #0b5ed7; color: #fff; }
    </style>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">REPORTS</p>
        <h1 class="mb-1">Timesheet Log Report</h1>
        <p class="text-muted mb-0">Review and export employee timesheet activity.</p>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-sm-6 col-xl-3">
                <label class="form-label" for="employeeFilter">Employee</label>
                <select id="employeeFilter" class="form-select">
                    <option value="">All employees</option>
                    @foreach (var employee in employees)
                    {
                        <option value="@employee.Id">@employee.FirstName @employee.LastName</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="statusFilter">Status</label>
                <select id="statusFilter" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<TimesheetStatus>())
                    {
                        <option value="@((int)status)">@(status == TimesheetStatus.InProgress ? "In Progress" : status.ToString())</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="dateFromFilter">Date from</label>
                <input id="dateFromFilter" type="date" class="form-control" />
            </div>
            <div class="col-sm-6 col-xl-2">
                <label class="form-label" for="dateToFilter">Date to</label>
                <input id="dateToFilter" type="date" class="form-control" />
            </div>
            <div class="col-sm-6 col-xl-2">
                <button type="button" id="resetTimesheetFilters" class="btn btn-outline-secondary w-100">Reset filters</button>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table id="timesheetLogTable" class="table table-hover align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee</th>
                        <th>Project</th>
                        <th>Task</th>
                        <th>Date</th>
                        <th>Start time</th>
                        <th>End time</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        var statusLabel = row.Status == TimesheetStatus.InProgress ? "In Progress" : row.Status.ToString();
                        <tr data-employee-id="@row.EmployeeId" data-status="@((int)row.Status)" data-start-date="@row.StartDate.ToString("yyyy-MM-dd")">
                            <td>@row.EmployeeId</td>
                            <td>@row.EmployeeName</td>
                            <td>@row.ProjectName</td>
                            <td>@row.TaskName</td>
                            <td data-order="@row.StartDate.ToString("yyyy-MM-dd")">@row.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>@row.StartTime.ToString(@"h\:mm")</td>
                            <td>@row.EndTime.ToString(@"h\:mm")</td>
                            <td>@statusLabel</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/v/dt/dt-3.1.5/datatables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/4.1.3/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/4.1.3/js/buttons.html5.min.js"></script>
    <script>
        const tableElement = document.getElementById('timesheetLogTable');
        const employeeFilter = document.getElementById('employeeFilter');
        const statusFilter = document.getElementById('statusFilter');
        const dateFromFilter = document.getElementById('dateFromFilter');
        const dateToFilter = document.getElementById('dateToFilter');

        const timesheetLogTable = new DataTable('#timesheetLogTable', {
            paging: true,
            pagingType: 'simple_numbers',
            searching: true,
            lengthChange: true,
            pageLength: 5,
            lengthMenu: [5, 10, 25, 50, 100],
            order: [[4, 'desc']],
            scrollX: true,
            layout: {
                topStart: ['pageLength', {
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: 'Export to Excel',
                            title: 'Timesheet Log Report',
                            exportOptions: { columns: ':visible', modifier: { search: 'applied', order: 'applied', page: 'all' } }
                        },
                        {
                            extend: 'pdfHtml5',
                            text: 'Download PDF',
                            title: 'Timesheet Log Report',
                            orientation: 'landscape',
                            pageSize: 'A4',
                            exportOptions: { columns: ':visible', modifier: { search: 'applied', order: 'applied', page: 'all' } }
                        }
                    ]
                }],
                topEnd: 'search',
                bottomStart: 'info',
                bottomEnd: 'paging'
            },
            language: {
                emptyTable: 'No timesheet logs found.',
                search: 'Search timesheet logs:'
            }
        });

        timesheetLogTable.search.fixed('employeeStatusDate', (_searchText, _rowData, dataIndex) => {
            const row = timesheetLogTable.row(dataIndex).node();
            if (!row) return true;

            const employeeMatches = !employeeFilter.value || row.dataset.employeeId === employeeFilter.value;
            const statusMatches = !statusFilter.value || row.dataset.status === statusFilter.value;
            const rowDate = row.dataset.startDate || '';
            const fromMatches = !dateFromFilter.value || rowDate >= dateFromFilter.value;
            const toMatches = !dateToFilter.value || rowDate <= dateToFilter.value;
            return employeeMatches && statusMatches && fromMatches && toMatches;
        });

        [employeeFilter, statusFilter, dateFromFilter, dateToFilter].forEach(filter => {
            filter.addEventListener('change', () => timesheetLogTable.draw());
        });
        document.getElementById('resetTimesheetFilters').addEventListener('click', () => {
            employeeFilter.value = '';
            statusFilter.value = '';
            dateFromFilter.value = '';
            dateToFilter.value = '';
            timesheetLogTable.search('').order([[4, 'desc']]).page('first').draw();
        });
    </script>
}
